<div class="modal-body">
  <%= form_tag(account_statement_clients_path(format: :pdf), :method => "get") do %>
    <%= hidden_field_tag :id, @client.id %>
    <div class="form-group row">
      <div class="col-sm-3">
		   <%= date_field_tag :as_at, class: "form-control form-control-sm" %>
      </div>
      <div class="col-sm-3"><%= submit_tag "Submit", class: "btn btn-primary btn-sm" %></div>
    </div>
  <% end %>
</div>