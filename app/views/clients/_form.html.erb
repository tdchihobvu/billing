<%= form_with(model: client, class: "box") do |form| %>
  <%= render "shared/form_errors", record: client %>
  <%= form.hidden_field :tenant_id %>

  <section class="zsect">
    <div class="boxh"><h2>Client</h2><span>Fields marked <span class="req"></span> are required</span></div>
    <div class="zgrid">
      <div class="zfield wide"><%= form.label :name, "Name", class: "req" %><%= form.text_field :name %></div>
      <div class="zfield"><%= form.label :trading_name, "Trading Name" %><%= form.text_field :trading_name %></div>
      <div class="zfield"><%= form.label :client_type_id, "Client Type", class: "req" %><%= form.select :client_type_id, ClientType.pluck(:name, :id), { prompt: "Select Type" } %></div>
      <div class="zfield"><%= form.label :industry_id, "Industry", class: "req" %><%= form.select :industry_id, tenant.industries.order("name Asc").pluck(:name, :id), { prompt: "Select Industry" } %></div>
      <div class="zfield"><%= form.label :bp_number, "Business Partner/TIN" %><%= form.text_field :bp_number %></div>
      <div class="zfield"><%= form.label :vat_number, "VAT Number" %><%= form.text_field :vat_number %></div>
      <div class="zfield"><%= form.label :currency_id, "Default Statement Currency", class: "req" %><%= form.select :currency_id, Currency.order("name Asc").pluck(:name, :id), { prompt: "Select Currency" } %></div>
    </div>
  </section>

  <section class="zsect">
    <div class="boxh"><h2>Address</h2></div>
    <div class="zgrid">
      <div class="zfield wide"><%= form.label :address_1, "Address Line 1", class: "req" %><%= form.text_field :address_1 %></div>
      <div class="zfield wide"><%= form.label :address_2, "Address Line 2" %><%= form.text_field :address_2 %></div>
      <div class="zfield"><%= form.label :location, "Location", class: "req" %><%= form.text_field :location %></div>
      <div class="zfield"><%= form.label :city, "City", class: "req" %><%= form.text_field :city %></div>
      <div class="zfield"><%= form.label :country, "Country", class: "req" %><%= form.text_field :country %></div>
    </div>
  </section>

  <section class="zsect">
    <div class="boxh"><h2>Contacts</h2></div>
    <div class="zgrid">
      <div class="zfield"><%= form.label :mobile, "Mobile Number" %><%= form.text_field :mobile, inputmode: "tel" %></div>
      <div class="zfield"><%= form.label :phone, "Phone Number", class: "req" %><%= form.text_field :phone, inputmode: "tel" %></div>
      <div class="zfield"><%= form.label :email, "Email", class: "req" %><%= form.email_field :email %></div>
      <div class="zfield"><%= form.label :website, "Website" %><%= form.text_field :website %></div>
    </div>
  </section>

  <section class="zsect">
    <div class="boxh"><h2>Contact Person Details</h2></div>
    <div class="zgrid">
      <div class="zfield"><%= form.label :cp_name, "Full Name" %><%= form.text_field :cp_name %></div>
      <div class="zfield"><%= form.label :cp_mobile, "Mobile Number" %><%= form.text_field :cp_mobile, inputmode: "tel" %></div>
      <div class="zfield"><%= form.label :cp_email, "Email" %><%= form.text_field :cp_email %></div>
    </div>
  </section>

  <div class="zformfoot">
    <%= link_to "Cancel", (client.persisted? ? client_path(client) : clients_path), class: "b" %>
    <%= form.submit "Save Client", class: "b main" %>
  </div>
<% end %>
