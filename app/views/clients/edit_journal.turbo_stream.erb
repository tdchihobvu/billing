<%= turbo_stream.replace "remote_modal" do %>
	<%= turbo_frame_tag :remote_modal, target: :_top do %>
	<!-- Modal -->
	<div class="modal fade" data-controller="modal">
	  <div class="modal-dialog modal-lg" role="document">
	    <div class="modal-content">
	      <div class="modal-header">
	        <h5 class="modal-title" id="exampleModalLongTitle">Edit Journal</h5>
	        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
	          <span aria-hidden="true">&times;</span>
	        </button>
	      </div>
	      <div class="modal-body">  
	        <%= form_for @transaction, url: update_journal_path do |form| %>
	          <% if @timesheet.errors.any? %>
	            <div id="error_explanation">
	              <h2><%= pluralize(@transaction.errors.count, "error") %> prohibited this Transaction from being saved:</h2>

	              <ul>
	                <% @transaction.errors.each do |error| %>
	                  <li><%= error.full_message %></li>
	                <% end %>
	              </ul>
	            </div>
	          <% end %>

	        <% end %>

	      </div>
	    </div>
	  </div>
	</div>
	<% end %>
<% end %>