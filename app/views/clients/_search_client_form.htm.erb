<%= turbo_frame_tag :remote_modal, target: :_top do %>
<!-- Modal -->
<div class="modal fade" data-controller="modal">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLongTitle">Select Date Range</h5>
        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
  		<%= form_tag("#{redirect_to}", :method => "get") do %>
            <div class="form-group row">
                <div class="col-sm-6">
  			   <label class="small text-gray">From:</label><br/>
  			   <%= date_field_tag :from, class: "form-control form-control-sm" %>
                </div>
                <div class="col-sm-6">
  			   <label class="small text-gray">To:</label><br/>
  			   <%= date_field_tag :to, class: "form-control form-control-sm" %>
                </div>
            </div>
            <p></p>
            <div class="form-group row">
              <div class="col-sm-3"><%= submit_tag "Submit", class: "btn btn-primary btn-sm" %></div>        
              <div class="col-sm-6">
              </div>
            </div>
  		<% end %>
      </div>
    </div>
  </div>
</div>
<% end %>