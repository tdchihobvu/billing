<div class="zpage">
  <%= render "shared/zhead", title: "Add/Edit Branches", crumb: link_to("Clients", clients_path) + " / " + link_to(@client.name, client_path(@client, tab: "branches")),
             sub: "Each branch can get its own licence. Leave unused rows empty.", actions: link_to("Back to client", client_path(@client, tab: "branches"), class: "b") %>

  <section class="box">
    <div class="boxh"><h2>Import from Excel</h2><span>Upload a spreadsheet of branches instead of typing them</span></div>
    <%= form_tag upload_branches_clients_path(client_id: @client), multipart: true, class: "zfilters" do %>
      <%= file_field_tag :file, accept: ".xls,.xlsx,.csv", "aria-label": "Branches spreadsheet" %>
      <%= submit_tag "Upload", name: nil, class: "b" %>
    <% end %>
  </section>

  <%= form_with(model: @client, class: "box") do |form| %>
    <%= render "shared/form_errors", record: @client %>
    <div class="boxh"><h2>Branches</h2><span>Fields marked <span class="req"></span> are required for each branch you fill in</span></div>
    <div class="zwrap">
      <table class="zt zbranches" style="min-width:720px">
        <thead><tr><th>#</th><th>Name on licence</th><th><span class="req">Street Address</span></th><th><span class="req">Location</span></th><th><span class="req">City</span></th></tr></thead>
        <tbody>
          <%= form.fields_for :branches do |f| %>
            <tr>
              <td class="muted"><%= f.index + 1 %><%= f.hidden_field :license_category_id %><%= f.hidden_field :license_option_id %><%= f.hidden_field :tenant_id %></td>
              <td><%= f.text_field :display_name, placeholder: "For example, Avondale branch", "aria-label": "Name on licence, row #{f.index + 1}" %></td>
              <td><%= f.text_field :address_1, "aria-label": "Street address, row #{f.index + 1}" %></td>
              <td><%= f.text_field :location, "aria-label": "Location, row #{f.index + 1}" %></td>
              <td><%= f.text_field :city, "aria-label": "City, row #{f.index + 1}" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="zformfoot">
      <%= link_to "Cancel", client_path(@client, tab: "branches"), class: "b" %>
      <%= form.submit "Save Branches", class: "b main" %>
    </div>
  <% end %>
</div>
