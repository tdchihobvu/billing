<div class="row">
	<div class="card border-0">
		<div class="card-body">
			<div class="card-title">Receipts for the Period <%= "#{@start_date.strftime("%d/%m/%Y")} To #{@end_date.strftime("%d/%m/%Y")}"%></div>
			<% unless @client.receipts.between_dates(@start_date,@end_date).empty? %>
			<table class="table table-striped">
				<thead>
					<tr>
						<th>#</th>
						<th>Date</th>
						<th>Receipt No.</th>
						<th>Description</th>
						<th>Payment Form</th>
						<th>Currency</th>
						<th>Amount</th>
						<th>Rate</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<% @client.receipts.between_dates(@start_date,@end_date).each_with_index do |receipt,i| %>
					<tr>
						<td><%= i+=1 %></td>
						<td><%= receipt.transaction_date.strftime("%d/%m/%Y") %></td>
						<td><%= receipt.reference_number %></td>
						<td><%= receipt.description %></td>
						<td><%= receipt.payment_form.name %></td>
						<td><%= receipt.currency.name %></td>
						<td><%= number_to_currency(receipt.amount, unit: "") %></td>
						<td><%= receipt.rate %></td>
						<td>
							<%= link_to receipt, title: "Print Receipt" do %>
								<i class="fas fa-print"></i>
							<% end %>
						</td>
					</tr>
					<% end %>
				</tbody>
			</table>
			<% else %>
			<p class="alert alert-info d-flex align-items-center" role="alert">There is nothing to display!</p>
			<% end %>
		</div>
	</div>
</div>