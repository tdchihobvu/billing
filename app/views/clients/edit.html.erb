<div class="zpage">
  <div class="zhead">
    <div>
      <div class="zcrumb"><%= link_to "Sales / Clients", clients_path %> / <%= link_to @client.name, @client %></div>
      <h1>Edit Client</h1>
    </div>
    <div class="acts"><%= link_to "Back to client", @client, class: "b" %></div>
