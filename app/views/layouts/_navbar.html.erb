<header class="app-topbar mb-4">
  <button type="button" id="sidebarToggleTop" class="app-topbar__icon" aria-label="Open the menu">
    <i class="fas fa-bars" aria-hidden="true"></i>
  </button>

  <button type="button" class="app-topbar__search" data-quick-search-open>
    <i class="fas fa-search" aria-hidden="true"></i>
    <span>Search pages, clients and invoices</span>
    <kbd>Ctrl K</kbd>
  </button>

  <% if current_user && can?("invoices.delete") %>
    <div class="app-topbar__right dropdown">
      <button type="button" class="app-topbar__icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Alerts, <%= unprocessed_notifications.size %> waiting">
        <i class="fas fa-bell" aria-hidden="true"></i>
        <% unless unprocessed_notifications.empty? %>
          <span class="app-topbar__count"><%= unprocessed_notifications.size %></span>
        <% end %>
      </button>
      <div class="dropdown-menu dropdown-menu-end app-alerts">
        <p class="app-alerts__title">Alerts</p>
        <% if unprocessed_notifications.empty? %>
          <p class="app-alerts__empty">No alerts are waiting.</p>
        <% end %>
        <% unprocessed_notifications.first(8).each do |notification| %>
          <a class="app-alerts__item" href="<%= void_requests_path(anchor: "request-#{notification.id}") %>">
            <span><%= notification.message %></span>
            <small>Requested <%= time_ago_in_words(notification.created_at) %> ago · review and decide</small>
          </a>
        <% end %>
        <% if unprocessed_notifications.any? %>
          <a class="app-alerts__item" href="<%= void_requests_path %>"><span><b>Open void requests</b></span><small><%= pluralize(unprocessed_notifications.size, "request") %> waiting</small></a>
        <% end %>
      </div>
    </div>
  <% end %>
</header>

<% unless current_user.nil? %>
  <%= render "layouts/quick_search" %>
<% end %>
