<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Sign in · <%= auth_brand[:name] %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-cache-control" content="no-cache">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>

  <%# Signed-out pages (sign in, forgot password, reset password) in the ZIMURA design. %>
  <body style="--brand: <%= auth_brand[:color] %>;">
    <%= render layout: "layouts/auth" do %><%= yield %><% end %>
  </body>
</html>
