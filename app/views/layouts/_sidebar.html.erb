<aside id="accordionSidebar" class="app-nav" style="--brand: <%= brand_color %>; --brand-ink: <%= brand_ink %>;" aria-label="Main menu">
  <div class="app-nav__head">
    <%= link_to root_path, class: "app-nav__brand", "aria-label": "#{tenant.trading_name.presence || tenant.company_name} home" do %>
      <% if (logo = tenant_logo_url) %>
        <span class="znav-logo"><%= image_tag logo, alt: "", width: 40, height: 40 %></span>
      <% else %>
        <svg class="znav-mark" width="34" height="34" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="22" r="13" fill="#f3b81b"/><path d="M14 36c0-7 2-12 6-15 4 3 6 8 6 15z" fill="var(--accent)"/><circle cx="20" cy="15" r="3" fill="var(--accent)"/></svg>
      <% end %>
      <span class="app-nav__name nav-label" title="<%= tenant.company_name %>">
        <%= tenant.trading_name.presence || tenant.company_name %>
        <small><%= tenant.trading_name.present? ? tenant.company_name : "Billing and licensing" %></small>
      </span>
    <% end %>
    <button type="button" id="sidebarToggle" class="app-nav__toggle" aria-label="Collapse or expand the menu">
      <i class="fas fa-angle-double-left app-nav__collapse-icon" aria-hidden="true"></i>
      <i class="fas fa-times app-nav__close-icon" aria-hidden="true"></i>
    </button>
  </div>

  <nav class="app-nav__scroll">
    <ul class="nav-list">
      <li class="nav-item">
        <%= link_to root_path, class: "nav-link", data: { nav_label: "Dashboard" } do %>
          <i class="fas fa-fw fa-th-large" aria-hidden="true"></i>
          <span class="nav-label">Dashboard</span>
        <% end %>
      </li>
    </ul>

    <p class="nav-group">Sales</p>
    <ul class="nav-list">
      <% if can_any?("clients.view", "clients.manage") %>
        <%= render layout: "layouts/nav_section", locals: { id: "collapseClients", icon: "fa-store", label: "Clients" } do %>
          <%= link_to "View clients", clients_path, class: "collapse-item" if can?("clients.view") %>
          <%= link_to "New client", new_client_path, class: "collapse-item" if can?("clients.manage") %>
          <%= link_to "Industries and tariffs", industries_path, class: "collapse-item" if can?("settings.manage") %>
        <% end %>
      <% end %>

      <% if quotations && default_module != 'licensing' && can_any?("invoices.view", "invoices.create") %>
        <%= render layout: "layouts/nav_section", locals: { id: "Employees", icon: "fa-file-signature", label: "Quotations" } do %>
          <%= link_to "New quotation", new_quotation_path, class: "collapse-item" if can?("invoices.create") %>
          <%= link_to "View quotations", quotations_path, class: "collapse-item" if can?("invoices.view") %>
        <% end %>
      <% end %>

      <% if invoicing && can_any?("invoices.view", "invoices.create") %>
        <%= render layout: "layouts/nav_section", locals: { id: "Invoices", icon: "fa-file-invoice-dollar", label: "Invoices", count: sidebar_overdue_count, count_label: "overdue" } do %>
          <%= link_to "New invoice", (default_module == 'licensing' ? license_invoices_path : proforma_invoices_path), class: "collapse-item" if can?("invoices.create") %>
          <%= link_to "View invoices", invoices_path, class: "collapse-item" if can?("invoices.view") %>
          <%= link_to "Credit notes", credit_notes_invoices_path, class: "collapse-item" if default_module != 'licensing' && can?("invoices.view") %>
        <% end %>
      <% end %>

      <% if receipting && can_any?("receipts.view", "receipts.create") %>
        <%= render layout: "layouts/nav_section", locals: { id: "receipts", icon: "fa-receipt", label: "Receipting" } do %>
          <%= link_to (default_module == 'licensing' ? "New receipt" : "General receipt"), new_receipt_path, class: "collapse-item" if can?("receipts.create") %>
          <%= link_to "View receipts", receipts_path, class: "collapse-item" if can?("receipts.view") %>
          <%= link_to "Shifts", shifts_receipts_path, class: "collapse-item" if can?("receipts.view") %>
        <% end %>
      <% end %>

      <% if licensing && (can_any?("licenses.view", "licenses.generate") || current_user.sees_license_approvals?) %>
        <%= render layout: "layouts/nav_section", locals: { id: "Licenses", icon: "fa-stamp", label: "Licensing", count: license_approvals_waiting_count, count_label: "awaiting your approval" } do %>
          <% if current_user.sees_license_approvals? %>
            <%= link_to license_approvals_path, class: "collapse-item" do %>Licence approvals<% if license_approvals_waiting_count.positive? %> <span class="visually-hidden">(<%= license_approvals_waiting_count %> waiting)</span><% end %><% end %>
          <% end %>
          <%= link_to "Generate license", new_license_path, class: "collapse-item" if can?("licenses.generate") %>
          <%= link_to "View licences", licenses_path, class: "collapse-item" if can?("licenses.view") %>
          <%= link_to "Auto renewal", licenses_path, class: "collapse-item" if can?("licenses.view") %>
          <%= link_to "Expiring licences", upcoming_renewals_reports_path, class: "collapse-item" if can?("reports.view") %>
        <% end %>
      <% end %>

      <% if inventory && can?("settings.manage") %>
        <%= render layout: "layouts/nav_section", locals: { id: "inventory", icon: "fa-boxes", label: "Inventory" } do %>
          <%= link_to "Stock sheet", products_path, class: "collapse-item" %>
          <%= link_to "Receive stock", new_goods_received_path, class: "collapse-item" %>
          <%= link_to "Product lines", products_path, class: "collapse-item" %>
          <%= link_to "Stock count", stock_counts_path, class: "collapse-item" %>
        <% end %>
      <% end %>
    </ul>

    <% if can?("reports.view") %>
    <p class="nav-group">Insights</p>
    <ul class="nav-list">
      <%= render layout: "layouts/nav_section", locals: { id: "reports", icon: "fa-chart-line", label: "Reports" } do %>
        <%= link_to "Sales", sales_reports_path, class: "collapse-item" %>
        <%= link_to "Collections", collections_reports_path, class: "collapse-item" %>
        <%= link_to "Overdue invoices", overdue_invoices_reports_path, class: "collapse-item" %>
        <%= link_to "Expiring licences", upcoming_renewals_reports_path, class: "collapse-item" %>
        <%= link_to "#{default_user_title} report", inspector_report_reports_path, class: "collapse-item" %>
      <% end %>
    </ul>
    <% end %>

    <% if can_any?("users.view", "roles.manage", "settings.manage", "settings.exchange_rates", "system.health") %>
    <p class="nav-group">Administration</p>
    <ul class="nav-list">
      <% if can?("users.view") %>
      <li class="nav-item">
        <%= link_to user_management_index_path, class: "nav-link", data: { nav_label: "Users" } do %>
          <i class="fas fa-fw fa-user-friends" aria-hidden="true"></i>
          <span class="nav-label">Users</span>
        <% end %>
      </li>
      <% end %>
      <% if can?("roles.manage") %>
      <li class="nav-item">
        <%= link_to roles_path, class: "nav-link", data: { nav_label: "Roles and permissions" } do %>
          <i class="fas fa-fw fa-user-shield" aria-hidden="true"></i>
          <span class="nav-label">Roles and permissions</span>
        <% end %>
      </li>
      <% end %>
      <% if can?("system.health") %>
      <% health_open = SystemEvent.where(tenant_id: [tenant.id, nil]).open.count %>
      <li class="nav-item">
        <%= link_to system_health_path, class: "nav-link", data: { nav_label: "System health" } do %>
          <i class="fas fa-fw fa-heartbeat" aria-hidden="true"></i>
          <span class="nav-label">System health</span>
          <% if health_open.positive? %><span class="znav-count nav-label" title="<%= health_open %> problems to look at"><%= health_open %></span><% end %>
        <% end %>
      </li>
      <% end %>

      <% if can_any?("settings.manage", "settings.exchange_rates") %>
      <%= render layout: "layouts/nav_section", locals: { id: "Settings", icon: "fa-sliders-h", label: "Settings" } do %>
        <%= link_to "General", system_settings_path, class: "collapse-item" if can?("settings.manage") %>
        <%= link_to "Inventory settings", inventory_index_path, class: "collapse-item" if inventory && can?("settings.manage") %>
        <%= link_to "Taxes", vat_types_path, class: "collapse-item" if can?("settings.manage") %>
        <%= link_to "Exchange rates", exchange_rates_path, class: "collapse-item" if can?("settings.exchange_rates") %>
        <%= link_to "Regional offices", regional_offices_path, class: "collapse-item" if can?("settings.manage") %>
      <% end %>
      <% end %>

      <% if api && can?("settings.manage") %>
        <%= render layout: "layouts/nav_section", locals: { id: "api", icon: "fa-plug", label: "Integrations" } do %>
          <%= link_to "Register app or device", new_device_path, class: "collapse-item" %>
          <%= link_to "Apps and devices", devices_path, class: "collapse-item" %>
        <% end %>
      <% end %>
    </ul>
    <% end %>
  </nav>

  <div class="app-nav__account">
    <div class="znav-acct">
      <%= link_to edit_user_registration_path, class: "znav-acct__link", data: { nav_label: "Your profile", palette_label: "Your profile" } do %>
        <i class="fas fa-fw fa-user" aria-hidden="true"></i><span class="nav-label">Your profile</span>
      <% end %>
      <% if can?("settings.manage") %>
      <%= link_to refresh_welcome_index_path, class: "znav-acct__link", data: { nav_label: "Refresh balances", palette_label: "Refresh balances" } do %>
        <i class="fas fa-fw fa-sync-alt" aria-hidden="true"></i><span class="nav-label">Refresh balances</span>
      <% end %>
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, class: "znav-acct__link", form: { class: "app-nav__logout" }, data: { nav_label: "Log out" } do %>
        <i class="fas fa-fw fa-sign-out-alt" aria-hidden="true"></i><span class="nav-label">Log out</span>
      <% end %>
    </div>
    <%= link_to edit_user_registration_path, class: "app-nav__person", "aria-label": "Your profile, #{current_user.fullname}", data: { nav_label: current_user.fullname } do %>
      <span class="app-nav__avatar" aria-hidden="true"><%= user_initials %></span>
      <span class="nav-label app-nav__who">
        <%= current_user.fullname %>
        <small><%= role_label(current_user.role) %></small>
      </span>
    <% end %>
  </div>
</aside>
<%# Applied before first paint, so the menu does not flash in the wrong state. %>
<script>try{if(innerWidth<768||localStorage.getItem("sidebar-collapsed")==="1"){document.body.classList.add("sidebar-toggled");document.getElementById("accordionSidebar").classList.add("toggled")}}catch(e){}</script>
