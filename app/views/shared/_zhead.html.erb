<%# Page header in the ZIMURA design. Locals: title, crumb (optional, may be HTML), sub (optional), actions (optional HTML). %>
<div class="zhead">
  <div>
    <% if local_assigns[:crumb].present? %><div class="zcrumb"><%= crumb %></div><% end %>
    <h1><%= title %></h1>
    <% if local_assigns[:sub].present? %><p><%= sub %></p><% end %>
  </div>
  <% if local_assigns[:actions].present? %><div class="acts"><%= actions %></div><% end %>
</div>
<% if notice.present? %><div class="znote ok"><span><i class="fas fa-check" aria-hidden="true"></i></span><div><%= notice %></div></div><% end %>
