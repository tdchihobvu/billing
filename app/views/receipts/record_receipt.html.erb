<div class="zpage">
  <div class="zhead">
    <div>
      <div class="zcrumb"><%= link_to "Sales / Receipting", receipts_path %></div>
      <h1>Record Receipt</h1>
      <p><%= link_to @client.name, @client %></p>
    </div>
    <div class="acts">
      <%= link_to "Choose another client", new_receipt_path, class: "b" %>
      <%= link_to "Client statement", client_path(@client, tab: "statement"), class: "b" %>
    </div>
  </div>

  <% if notice.present? %><div class="znote ok"><span><i class="fas fa-check" aria-hidden="true"></i></span><div><%= notice %></div></div><% end %>

  <%= render "form", receipt: @receipt %>
</div>
