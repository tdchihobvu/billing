<% r = @receipt %>
<div class="zpage">
  <div class="zhead">
    <div>
      <div class="zcrumb"><%= link_to "Sales / Receipting", receipts_path %></div>
      <h1>Receipt <%= r.reference_number %></h1>
    </div>
    <div class="acts">
      <%= link_to "All Receipts", receipts_path, class: "b" %>
      <%= link_to print_receipts_path(id: r), class: "b" do %><i class="fas fa-print" aria-hidden="true"></i> Print<% end %>
      <% unless r.deleted? %>
        <%= link_to r, class: "b danger", data: { turbo_method: :delete, turbo_confirm: "Void receipt #{r.reference_number}? The payment comes off #{r.invoice ? r.invoice.invoice_number : 'the client account'} and the statement." } do %><i class="fas fa-times" aria-hidden="true"></i> Void<% end %>
      <% end %>
    </div>
  </div>

  <% if notice.present? %><div class="znote ok"><span><i class="fas fa-check" aria-hidden="true"></i></span><div><%= notice %></div></div><% end %>
  <% if r.deleted? %>
    <div class="znote err"><span><i class="fas fa-times" aria-hidden="true"></i></span><div><b>This receipt is void</b>It no longer counts towards the client's balance.</div></div>
  <% end %>

  <div class="zsplit">
    <section class="box zdoc" aria-label="Receipt">
      <div class="zdoctop">
        <div>
          <span class="ztag <%= r.deleted? ? '' : 'paid' %>"><%= r.deleted? ? "Void" : (r.receipt_type.present? && r.receipt_type != "payment" ? r.receipt_type.humanize : "Received") %></span>
          <h2><%= link_to r.client.name, r.client %></h2>
          <small class="muted"><%= [r.client.address_1, r.client.location, r.client.city].compact_blank.join(", ") %></small>
        </div>
        <div class="zowed"><small class="muted">Amount</small><b><span class="cur"><%= r.currency&.name %></span><%= number_with_precision(r.amount, precision: 2, delimiter: ",") %></b></div>
      </div>
      <div class="zfacts">
        <div><small>Transaction Date</small><b><%= r.transaction_date.strftime("%d %b %Y") %></b></div>
        <div><small>Payment Form</small><b><%= r.payment_form&.name %></b></div>
        <div><small>Transaction By</small><b><%= r.user&.user_fullname || r.user_fullname %></b></div>
        <div><small>Rate</small><b><%= r.rate %></b></div>
      </div>
      <div class="zdetails" style="padding:0">
        <div><small class="muted">Invoice</small><div><b><%= r.invoice ? link_to(r.invoice.invoice_number, r.invoice) : "On account" %></b></div></div>
        <div><small class="muted">Description</small><div><b><%= r.description.presence || "None" %></b></div></div>
        <% if r.invoice && r.invoice.discount_amount.to_d.positive? %>
          <div><small class="muted">Invoice discount</small><div><b><%= number_with_precision(r.invoice.discount_amount, precision: 2, delimiter: ",") %></b></div></div>
        <% end %>
        <% if r.reason.present? %><div><small class="muted">Reason</small><div><b><%= r.reason %></b></div></div><% end %>
      </div>
    </section>

    <section class="box" aria-label="Receipt QR code">
      <div class="boxh"><h2>Verification</h2><span>QR code printed on the receipt</span></div>
      <div style="padding:6px 18px 18px;display:grid;justify-items:center">
        <% if r.qr_code.attached? %>
          <%= image_tag r.qr_code, alt: "QR code for receipt #{r.reference_number}", style: "width:180px;height:180px" %>
        <% else %>
          <%= zempty("No QR code", "This receipt was saved without one.") %>
        <% end %>
      </div>
    </section>
  </div>
</div>
