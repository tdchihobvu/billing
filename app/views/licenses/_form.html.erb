<%= form_with(model: license, class: "box") do |form| %>
  <%= render "shared/form_errors", record: license %>
  <%= form.hidden_field :client_id %>

  <section class="zsect">
    <div class="boxh"><h2>License</h2><span>Fields marked <span class="req"></span> are required</span></div>
    <div class="zgrid">
      <div class="zfield wide">
        <% paid_invoices = @client.invoices.active.select { |invoice| invoice.balance <= 0 } %>
        <%= form.label :invoice_id, "Select Invoice", class: "req" %>
        <%= form.select :invoice_id, paid_invoices.collect { |b| [b.invoice_number, b.id] }, { prompt: "Select Invoice" } %>
        <span class="zhint"><%= paid_invoices.empty? ? "This client has no fully paid invoices yet." : "Only fully paid invoices are listed." %></span>
      </div>
      <div class="zfield"><%= form.label :license_category_id, "License category", class: "req" %><%= form.select :license_category_id, LicenseCategory.all.collect { |a| [a.name, a.id] }, { prompt: "Select Category" } %></div>
      <div class="zfield"><%= form.label :renewal_date, "Renewal date", class: "req" %><%= form.date_field :renewal_date %></div>
      <div class="zfield"><%= form.label :amount, "Invoice Amount" %><%= form.text_field :amount, inputmode: "decimal" %></div>
      <div class="zfield"><%= form.label :quantity, "No. of Licenses" %><%= form.text_field :quantity, inputmode: "numeric" %></div>
      <div class="zfield wide">
        <span class="zlabel req">License option</span>
        <div class="zchoices" role="radiogroup" aria-label="License option">
          <% LicenseOption.active.each do |o| %>
            <label><%= form.radio_button :license_option_id, o.id %> <%= o.name %></label>
          <% end %>
        </div>
      </div>
      <div class="zfield"><%= form.label :special_days, "Special days" %><%= form.number_field :special_days %><span class="zhint">Fill in for a Special licence only.</span></div>
      <div class="zfield" style="align-self:end"><label class="zcheck"><%= form.check_box :auto_renewal %> Auto renewal</label></div>
    </div>
  </section>

  <div class="zformfoot">
    <%= link_to "Cancel", (license.persisted? ? license_path(license) : generate_licenses_path(client_id: @client)), class: "b" %>
    <%= form.submit (license.persisted? ? "Update License" : "Create License"), class: "b main" %>
  </div>
<% end %>
