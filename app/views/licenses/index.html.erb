<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Valid Licenses</h1>
    <div class="float-end">
      <%= link_to new_license_path, class: "d-none d-sm-inline-block btn btn-sm btn-outline text-dark" do %>
      <i class="fas fa-file fa-sm text-dark"></i> Generate New
      <% end %> |
      <%= link_to :back, class: "btn btn-outline btn-sm rounded-0" do %><i class="fas fa-backward text-dark"></i> Back <% end %> 
    </div>
</div>

<p style="color: green"><%= notice %></p>
<div class="card border-0">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped small" id="dataTable">
        <thead>
          <tr>
            <th>#</th>
            <th>Client</th>
            <th>Period</th>
            <th>Option</th>
            <th>Status</th>
            <th>Print</th>
          </tr>
        </thead>
        <tbody>
          <div id="clients">
            <% @licenses.each_with_index do |license,i| %>
              <% unless license.invoice.deleted? %>
              <tr>
                <td><%= i+=1 %></td>
                <td><%= license.client.name %></td>
                <td><%= license.long_period %></td>
                <td><%= license.license_option.name %></td>
                <td><%= license.status %></td>
                <td> 
                  <% if license.paid? %> 
                    <% if license.client.branches.empty? %>        
                      <%= link_to print_licenses_path(id: license, format: :pdf), target: '_blank', class: "btn btn-outline text-dark small", title: "Print With Letterhead" do %>
                        <i class="fas fa-print fa-sm text-dark"></i> 
                      <% end %>
                      <%= link_to print_plain_licenses_path(id: license, format: :pdf), target: '_blank', class: "btn btn-outline text-dark small", title: "Print Without Letterhead" do %>
                        <i class="fas fa-file fa-sm text-dark"></i> 
                      <% end %>
                    <% else %>
                      <%= link_to print_multiple_licenses_path(id: license, client_id: license.client_id), target: '_blank', class: "btn btn-outline text-dark small", title: "Print Multiple" do %>
                        <i class="fas fa-print fa-sm text-dark"></i> 
                      <% end %>
                    <% end %>
                  <% else %>
                    <%= link_to license.invoice, class: "btn btn-outline text-dark small", title: "Print License" do %>
                      <i class="fas fa-eye fa-sm text-dark"></i> 
                    <% end %>
                  <% end %>
                </td>
              </tr>
              <% end %>
            <% end %>
          </div>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script type="text/javascript">
  $(document).ready(function() {
    $('#dataTable').DataTable();
  });
</script>
