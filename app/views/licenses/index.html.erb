<%
  keep = request.query_parameters.slice("q", "paid")
  filtered = keep.values.any?(&:present?)
  today = Date.current
%>
<div class="zpage">
  <div class="zhead">
    <div>
      <div class="zcrumb">Licensing</div>
      <h1>Valid Licenses</h1>
      <p><%= number_with_delimiter(@count) %> licences valid today or later<%= ", matching your filters" if filtered %>.</p>
    </div>
    <div class="acts">
      <%= link_to "Expiring licences", upcoming_renewals_reports_path, class: "b" %>
      <%= link_to new_license_path, class: "b main" do %><i class="fas fa-plus" aria-hidden="true"></i> Generate New<% end %>
    </div>
  </div>

  <% if notice.present? %><div class="znote ok"><span><i class="fas fa-check" aria-hidden="true"></i></span><div><%= notice %></div></div><% end %>

  <section class="box" aria-label="Licence list">
    <%= form_with url: licenses_path, method: :get, class: "zfilters", data: { turbo_action: "advance" } do |f| %>
      <label class="zsearch"><span class="visually-hidden">Search licences</span><i class="fas fa-search" aria-hidden="true"></i>
        <%= f.search_field :q, value: params[:q], placeholder: "Client or invoice number" %></label>
      <%= f.select :paid, [["Paid", "yes"], ["Not paid", "no"]], { include_blank: "Paid or not" , selected: params[:paid] }, class: "zsel #{'on' if params[:paid].present?}", "aria-label": "Payment", onchange: "this.form.requestSubmit()" %>
      <%= f.submit "Search", name: nil, class: "b" %>
      <div class="right"><% if filtered %><%= link_to "Clear all", licenses_path, class: "zlink", style: "color:var(--soft)" %><% end %></div>
    <% end %>

    <% if @licenses.any? %>
      <div class="zwrap">
        <table class="zt">
          <thead><tr><th>Client</th><th>Licence</th><th>Option</th><th>Period</th><th>Expires</th><th>Status</th><th>Print</th></tr></thead>
          <tbody>
            <% @licenses.each do |license| %>
              <% left = license.expiry_date ? (license.expiry_date - today).to_i : nil %>
              <tr>
                <td class="zvn"><b><%= link_to license.client.name, license.client, style: "color:inherit;text-decoration:none" %></b><small><%= link_to license.invoice.invoice_number, license.invoice, class: "zno" %></small></td>
                <td><%= license.license_for %></td>
                <td><%= license.license_option&.name %></td>
                <td><%= license.long_period if license.renewal_date && license.expiry_date %></td>
                <td><% if left %><span class="ztag <%= left <= 7 ? 'part' : '' %>"><%= left.zero? ? "Today" : "In #{pluralize(left, 'day')}" %></span><% end %></td>
                <td><span class="ztag <%= license.paid? ? 'paid' : 'late' %>"><%= license.paid? ? "Paid" : "Not paid" %></span><% unless license.printable? || !license.paid? %> <%= zlicense_approval_tag(license) %><% end %></td>
                <td>
                  <div class="acts">
                    <% if license.printable? %>
                      <% if license.client.branches.empty? %>
                        <%= link_to "With Letterhead", print_licenses_path(id: license, format: :pdf), class: "b", target: "_blank", rel: "noopener", title: "Print With Letterhead" %>
                        <%= link_to "Without Letterhead", print_plain_licenses_path(id: license, format: :pdf), class: "b", target: "_blank", rel: "noopener", title: "Print Without Letterhead" %>
                      <% else %>
                        <%= link_to "Print Multiple", print_multiple_licenses_path(id: license, client_id: license.client_id), class: "b", target: "_blank", rel: "noopener" %>
                      <% end %>
                    <% else %>
                      <%= link_to "View Invoice", license.invoice, class: "b" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="zpager">
        <span>Page <%= @page %> of <%= @pages %>, soonest expiry first</span>
        <span class="acts">
          <%= link_to "Previous", licenses_path(keep.merge(page: @page - 1)), class: "b #{'disabled' if @page <= 1}" %>
          <%= link_to "Next", licenses_path(keep.merge(page: @page + 1)), class: "b #{'disabled' if @page >= @pages}" %>
        </span>
      </div>
    <% else %>
      <%= zempty(filtered ? "No licences match these filters" : "No valid licences", filtered ? "Try another client name." : "Licences appear here once licence invoices are raised.", (link_to("Clear all", licenses_path, class: "b") if filtered)) %>
    <% end %>
  </section>
</div>
