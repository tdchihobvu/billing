<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><%= @client.name %> Branches Licenses</h1>
    <div class="float-end">
      <%= link_to download_all_licenses_path(id: @license, client: @client, format: :pdf), class: "btn btn-outline btn-sm rounded-0" do %><i class="fas fa-download text-dark"></i> Download All <% end %> |
      <%= link_to :back, class: "btn btn-outline btn-sm rounded-0" do %><i class="fas fa-backward text-dark"></i> Back <% end %> 
    </div>
</div>

<div class="card border-0">
  <div class="card-body">
    <table class="table table-striped small">
      <% @branches.each_with_index do |branch,i| %>
      <tr>
        <td>
          <%= i+=1 %>.
        </td>
        <td>
          <%= branch.name %>
        </td>
        <td>
          <%= branch.full_address %>
        </td>
        <td>
          <%= link_to 'Print', branch_license_licenses_path(branch_id: branch, license_id: @license, format: :pdf), target: '_blank' %>
        </td>
      </tr>
      <% end %>
    </table>
  </div>
</div>