<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Valid Licenses for <%= @client.name %></h1>
    <div class="float-end">
      <%= link_to generate_new_licenses_path(client_id: @client), class: "btn btn-outline btn-sm rounded-0" do %>
        <i class="fas fa-backward text-dark"></i> Generate License
      <% end %> 
      <%= link_to :back, class: "btn btn-outline btn-sm rounded-0" do %><i class="fas fa-backward text-dark"></i> Back <% end %> 
    </div>
</div>

<p style="color: green"><%= notice %></p>

<div class="card border-0">
  <div class="card-body">
    <% unless @license.nil? %>
        <% if @license.paid? %> 
          <% if @license.client.branches.empty? %>        
            <%= link_to print_licenses_path(id: @license, format: :pdf), target: '_blank', class: "btn btn-outline text-dark small", title: "Print Receipt" do %>
              <i class="fas fa-print fa-sm text-dark"></i> <%= "Single License for the Period #{@license.long_period}" %>
            <% end %>
          <% else %>
            <%= link_to print_multiple_licenses_path(id: @license, client_id: @license.client_id), class: "btn btn-outline text-dark small", title: "Print Multiple" do %>
              <i class="fas fa-print fa-sm text-dark"></i> <%= "Multiple Licenses for the Period #{@license.long_period}" %>
            <% end %>
          <% end %>
        <% end %>      
    <% end %>
  </div>
</div>
