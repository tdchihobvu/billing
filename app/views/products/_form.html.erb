<%= form_with(model: product) do |form| %>
  <% if product.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul>
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :code, style: "display: block" %>
    <%= form.text_field :code %>
  </div>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :barcode, style: "display: block" %>
    <%= form.text_field :barcode %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :measuring_unit_id, "Unit of Measurement", style: "display: block" %>
    <%= form.select :measuring_unit_id, MeasuringUnit.all.collect {|p| [p.name, p.id]}, {prompt: "Select Unit"} %>
  </div>

  <div>
    <%= form.label :brand_id, style: "display: block" %>
    <%= form.select :brand_id, Brand.all.collect {|p| [p.name, p.id]}, {prompt: "Select Brand"} %>
  </div>

  <div>
    <%= form.label :product_category_id, style: "display: block" %>
    <%= form.select :product_category_id, ProductCategory.all.collect {|p| [p.description, p.id]}, {prompt: "Select Category"} %>
  </div>

  <div>
    <%= form.label :product_type_id, style: "display: block" %>
    <%= form.select :product_type_id, ProductType.all.collect {|p| [p.name, p.id]}, {prompt: "Select Type"}  %>
  </div>

  <div>
    <%= form.label :vat_type_id, style: "display: block" %>
    <%= form.select :vat_type_id, VatType.all.collect {|p| [p.name, p.id]}, {prompt: "Select Type"}  %>
  </div>

  <div>
    <%= form.label :active, style: "display: block" %>
    <%= form.check_box :active %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
