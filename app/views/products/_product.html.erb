<div id="<%= dom_id product %>">
  <p>
    <strong>Code:</strong>
    <%= product.code %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= product.name %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= product.description %>
  </p>

  <p>
    <strong>Product category:</strong>
    <%= product.product_category_id %>
  </p>

  <p>
    <strong>Product type:</strong>
    <%= product.product_type_id %>
  </p>

  <p>
    <strong>Vat type:</strong>
    <%= product.vat_type_id %>
  </p>

  <p>
    <strong>Active:</strong>
    <%= product.active %>
  </p>

</div>
