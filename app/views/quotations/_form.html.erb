<h6>All fields marked with <span class="required_field"></span> are mandatory</h6>
<%= form_with(model: quotation) do |form| %>
  <% if quotation.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(quotation.errors.count, "error") %> prohibited this quotation from being saved:</h2>

      <ul>
        <% quotation.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <div class="form-group">
      <%= form.label :client_id, style: "display: block", class: "required_field" %>
      <%#= form.select :client_id, current_user.tenant.clients.order('name Asc').pluck(:name, :id), {include_blank: true}, {data: {controller: 'slim'}, class: "small"} %>
      <%= form.select :client_id, current_user.tenant.clients.order('name Asc').pluck(:name, :id), {prompt: 'Select Client'},class: "form-select form-control-sm" %>
    </div>

    <div class="row">
        <div class="col-sm-6">
           <div class="form-group">
            <%= form.label :quotation_date, "Quotation Date", style: "display: block", class: "required_field" %>
            <%= form.date_field :quotation_date, class:'form-control form-control-sm' %>
          </div>
        </div>
         <div class="col-sm-6">
          <div class="form-group">
            <%= form.label :quotation_number, "Quotation Number", style: "display: block", class: "required_field" %>
            <%= form.text_field :quotation_number, class:'form-control form-control-sm' %>
          </div>
        </div>
    </div>
    <div class="row">
      <div class="col-sm-6">
        <div class="form-group">
        <%= form.label :currency_id, style: "display: block", class: "required_field" %>
        <%= form.select :currency_id, Currency.pluck(:name, :id), {prompt: "Select Currency"},class:'form-select form-control-sm' %>
        </div>
      </div>
      <div class="col-sm-6">
        <div class="form-group">
        <%= form.label :bank_id, "Bank Details", style: "display: block", class: "required_field" %>
        <%= form.select :bank_id, Bank.order('bank_name Asc').collect {|b| [b.description, b.id]}, {prompt: "Select Bank"}, class:'form-select form-control-sm' %>
        </div>
      </div>
    </div>

    <div class="form-group">
      <%= form.label :validity, "Validity Period (Days)", style: "display: block", class: "required_field" %>
      <%= form.number_field :validity, class:'form-control form-control-sm' %>
    </div>

    <div class="form-group">
      <strong><%= form.label :quotation_terms, "Define Quotation Terms", style: "display: block" %></strong>
      <%= form.rich_text_area :quotation_terms, rows: 6 %>
    </div>

    <div class="form-group">
      <strong><%= form.label :product_pricing, "Define Item Pricing", style: "display: block" %></strong>
      <%= form.radio_button :product_pricing, 'inclusive' %> Unit Price Includes VAT &nbsp;&nbsp; <%= form.radio_button :product_pricing, 'exclusive' %> Unit Price Excludes VAT
    </div>

  <h6 class="required_field"><strong>Quotation Items</strong></h6>
  <p></p>

  <!-- Nested attributes - Quotation Items -->
  <div class="row">
      <div class="col-sm-6 small fw-bold">Description</div>
      <div class="col-sm-2 small fw-bold">Quantity</div>
      <div class="col-sm-2 small fw-bold">Unit Price</div>
      <div class="col-sm-2 small fw-bold">VAT Type</div>
  </div>
  <div class="row">
    <%= form.fields_for :quotation_items do |f| %>
      <div class="col-sm-6"><div class="form-group"><%= f.text_area :description, placeholder: "Item Description", rows: 2, class: 'form-control form-control-sm' %></div></div>
      <div class="col-sm-2"><div class="form-group"><%= f.number_field :quantity, class: 'form-control form-control-sm' %></div></div>
      <div class="col-sm-2"><div class="form-group"><%= f.text_field :unit_price, class: 'form-control form-control-sm' %></div></div>
      <div class="col-sm-2"><div class="form-group"><%= f.select :vat_type_id, VatType.all.collect {|v| [v.description, v.id]}, {prompt: "Select Type"}, class: 'form-control form-control-sm' %></div></div>
    <% end %>
  </div>

  <div class="form-group text-center mt-4">
    <%= form.submit "Save Quotation", class:'btn btn-lg btn-success' %>
  </div>
<% end %>
