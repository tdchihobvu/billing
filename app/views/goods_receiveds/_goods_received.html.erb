<div id="<%= dom_id goods_received %>">
  <p>
    <strong>Grv number:</strong>
    <%= goods_received.grv_number %>
  </p>

  <p>
    <strong>Ext number:</strong>
    <%= goods_received.ext_number %>
  </p>

  <p>
    <strong>Supplier:</strong>
    <%= goods_received.supplier_id %>
  </p>

  <p>
    <strong>Date received:</strong>
    <%= goods_received.date_received %>
  </p>

  <p>
    <strong>User:</strong>
    <%= goods_received.user_id %>
  </p>

  <p>
    <strong>Deleted:</strong>
    <%= goods_received.deleted %>
  </p>

</div>
