<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Currencies</h1>
    <div class="float-end">
      <%= link_to new_currency_path, class: "d-none d-sm-inline-block btn btn-sm btn-outline text-dark" do %>
      <i class="fas fa-file fa-sm text-dark"></i> Create New
      <% end %> |
      <%= link_to :back, class: "btn btn-outline btn-sm rounded-0" do %><i class="fas fa-backward text-dark"></i> Back <% end %> 
    </div>
</div>

<p style="color: green"><%= notice %></p>

<div class="card border-0">
  <div class="card-body">
    <% unless @currencies.empty? %>
    <div class="table-responsive">
      <table class="table table-striped small" id="dataTable">
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Symbol</th>
            <th>Origin</th>
            <th>Rate</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <div id="clients">
            <% @currencies.each_with_index do |currency,i| %>
              <tr>
                <td><%= i+=1 %></td>
                <td><%= currency.name %></td>
                <td><%= currency.symbol %></td>
                <td><%= currency.origin %></td>
                <td><%= currency.rate %></td>
                <td>          
                  <%= link_to currency, class: "btn btn-outline text-dark small", title: "Print Receipt" do %>
                    <i class="fas fa-eye fa-sm text-dark"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </div>
        </tbody>
      </table>
    </div>
    <% else %>
      <div class="alert alert-warning text-center border-0" role="alert">There is nothing to display.</div>
    <% end %>
  </div>
</div>

<script type="text/javascript">
  $(document).ready(function() {
    $('#dataTable').DataTable();
  });
</script>
