<% if DeviceSetting.all.empty? and system_mode == 'client' %>
  <%# This device must be registered before anyone can sign in on it. %>
  <h1 class="zauth__title">Enter Device ID</h1>
  <p class="zauth__sub">Register this device before signing in.</p>
  <%= form_tag register_device_welcome_index_path, class: "zauth__form" do %>
    <div class="zfield"><%= label_tag :deviceID, "Device ID" %><%= text_field_tag :deviceID, nil, autofocus: true %></div>
    <%= submit_tag "Register Device", class: "b main zauth__go", data: { turbo_submits_with: "Registering…" } %>
  <% end %>
<% else %>
  <h1 class="zauth__title">Welcome back</h1>
  <p class="zauth__sub">Sign in to <%= auth_brand[:name] %> Billing and Licensing.</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "zauth__form", data: { controller: "signin" } }) do |f| %>
    <div class="zfield">
      <%= f.label :username, "Username" %>
      <%= f.text_field :username, autofocus: true, autocomplete: "username", autocapitalize: "none", spellcheck: false, required: true %>
    </div>

    <div class="zfield">
      <div class="zauth__labelrow">
        <%= f.label :password %>
        <%= link_to "Forgot password?", new_password_path(resource_name), class: "zauth__forgot" %>
      </div>
      <div class="zauth__pw">
        <%= f.password_field :password, autocomplete: "current-password", required: true, "aria-describedby": "caps-warning",
                             data: { signin_target: "password", action: "keyup->signin#caps keydown->signin#caps blur->signin#hideCaps" } %>
        <button type="button" class="zauth__eye" aria-label="Show password" aria-pressed="false"
                data-signin-target="toggle" data-action="signin#toggle"><i class="far fa-eye" aria-hidden="true"></i></button>
      </div>
      <span class="zauth__caps" id="caps-warning" data-signin-target="caps" hidden><i class="fas fa-arrow-up" aria-hidden="true"></i> Caps Lock is on</span>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="zcheck"><%= f.check_box :remember_me %> Keep me signed in on this computer</label>
    <% end %>

    <%= f.submit "Log in", class: "b main zauth__go", data: { turbo_submits_with: "Signing in…" } %>
  <% end %>

  <details class="zauth__trouble">
    <summary>Trouble signing in?</summary>
    <ul>
      <li>Forgot your password? <%= link_to "Reset it by email", new_password_path(resource_name) %></li>
      <% if devise_mapping.confirmable? %><li>New account? <%= link_to "Resend confirmation instructions", new_confirmation_path(resource_name) %></li><% end %>
      <% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) %><li>Account locked after too many tries? <%= link_to "Send unlock instructions", new_unlock_path(resource_name) %></li><% end %>
      <li>Forgot your username? Ask your administrator.</li>
    </ul>
  </details>
<% end %>
