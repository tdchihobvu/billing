<h1 class="zauth__title">Forgot your password?</h1>
<p class="zauth__sub">Enter your email and we'll send you a link to choose a new one.</p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "zauth__form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <div class="zfield"><%= f.label :email %><%= f.email_field :email, autofocus: true, autocomplete: "email" %></div>
  <%= f.submit "Send me reset password instructions", class: "b main zauth__go" %>
<% end %>

<div class="zauth__links"><%= render "devise/shared/links" %></div>
