<h1 class="zauth__title">Change your password</h1>
<p class="zauth__sub"><%= User::PASSWORD_RULES %></p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "zauth__form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>
  <div class="zfield"><%= f.label :password, "New password" %><%= f.password_field :password, autofocus: true, autocomplete: "new-password" %></div>
  <div class="zfield"><%= f.label :password_confirmation, "Confirm new password" %><%= f.password_field :password_confirmation, autocomplete: "new-password" %></div>
  <%= f.submit "Change my password", class: "b main zauth__go" %>
<% end %>

<div class="zauth__links"><%= render "devise/shared/links" %></div>
