<%= form_with(model: regional_office) do |form| %>
  <% if regional_office.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(regional_office.errors.count, "error") %> prohibited this regional_office from being saved:</h2>

      <ul>
        <% regional_office.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :region_id, style: "display: block" %>
    <%= form.select :region_id, Region.all.collect {|r| [r.name, r.id]}, {prompt: "Select Region"} %>
  </div>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
