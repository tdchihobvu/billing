  </div>
  <div class="form-group">
    <%= form.label :amount, "Tariff Rate/Fee", class: "text-dark" %>
    <%= form.text_field :amount, class: "form-control form-control-sm" %>
  </div>
  <div>
    <%= form.submit %>
  </div>
<% end %>
