<div class="zpage">
  <%= render "shared/zhead", title: "Inactive Invoices", crumb: link_to("Sales / Invoices", invoices_path),
             sub: "Invoices moved to trash. They don't count towards balances or reports.",
             actions: safe_join([link_to("View invoices", invoices_path, class: "b"),
                                 link_to(proforma_invoices_path, class: "b main") { safe_join([tag.i(class: "fas fa-plus", "aria-hidden": "true"), " New Invoice"]) }]) %>

  <section class="box">
    <% if @invoices.any? %>
      <div class="zwrap">
        <table class="zt">
          <thead><tr><th>Invoice</th><th>Date</th><th>Client</th><th class="r">Total</th><th>Status</th><th><span class="visually-hidden">Open</span></th></tr></thead>
          <tbody>
            <% @invoices.each do |invoice| %>
              <tr>
                <td class="zvn"><%= link_to invoice.invoice_number, invoice, class: "zno" %><small><%= invoice.document.to_s.capitalize %></small></td>
                <td class="money"><%= invoice.invoice_date.strftime("%d %b %Y") %></td>
                <td><%= invoice.client&.name %></td>
                <td class="r money"><span class="cur"><%= invoice.currency.name %></span> <%= number_to_currency(invoice.invoice_total, unit: "") %></td>
                <td><%= zstatus_tag(invoice) %></td>
                <td style="text-align:right"><%= link_to invoice, class: "b", title: "Open invoice #{invoice.invoice_number}" do %><i class="fas fa-print" aria-hidden="true"></i><span class="visually-hidden">Open invoice <%= invoice.invoice_number %></span><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= zempty("No inactive invoices", "Invoices moved to trash appear here.") %>
    <% end %>
  </section>
</div>
