<%= form_for credit_note, url: save_credit_note_invoices_path, html: { class: "box" } do |form| %>
  <%= render "shared/form_errors", record: credit_note %>
  <%= form.hidden_field :tenant_id %>

  <section class="zsect">
    <div class="boxh"><h2>Credit note</h2><span>Fields marked <span class="req"></span> are required</span></div>
    <div class="zgrid">
      <div class="zfield"><%= form.label :document_number, "Credit Note No." %><%= form.text_field :document_number, readonly: true %></div>
      <div class="zfield"><%= form.label :transaction_date, "Transaction Date", class: "req" %><%= form.date_field :transaction_date %></div>
      <div class="zfield wide"><%= form.label :invoice_id, "Invoice to Credit", class: "req" %><%= form.select :invoice_id, @tenant.invoices.sales.pluck(:invoice_number, :id), { prompt: "Select Invoice" } %></div>
      <div class="zfield wide"><%= form.label :reason, "Reason for Credit Note", class: "req" %><%= form.text_area :reason %></div>
    </div>
  </section>

  <div class="zformfoot">
    <%= link_to "Cancel", credit_notes_invoices_path, class: "b" %>
    <%= form.submit "Save Credit Note", class: "b main" %>
  </div>
<% end %>
