<% inv = @invoice %>
<div class="zpage">
  <%= render "shared/zhead", title: "Setoff Invoice ##{inv.invoice_number}", crumb: link_to("Invoices / #{inv.invoice_number}", invoice_path(inv)), sub: inv.client&.name %>
  <%= form_with url: setoff_invoice_path(inv), method: :post, class: "box" do |form| %>
    <div class="zstats" style="padding:18px 18px 0">
      <div class="zstat"><small>Invoice Total</small><b><%= inv.currency.symbol %> <%= number_with_precision(inv.total, precision: 2, delimiter: ",") %></b></div>
      <div class="zstat owe"><small>Outstanding Balance</small><b><%= inv.currency.symbol %> <%= number_with_precision(inv.invoice_balance, precision: 2, delimiter: ",") %></b></div>
    </div>
    <section class="zsect">
      <div class="boxh"><h2>Setoff</h2><span>Fields marked <span class="req"></span> are required</span></div>
      <div class="zgrid">
        <div class="zfield"><%= form.label :transaction_date, "Transaction Date", class: "req" %><%= form.date_field :transaction_date, required: true %></div>
        <div class="zfield"><%= form.label :amount, "Setoff Amount", class: "req" %><%= form.number_field :amount, value: inv.invoice_balance, step: "0.01", min: "0.01", max: inv.invoice_balance, required: true %></div>
        <div class="zfield"><%= form.label :payment_form_id, "Payment Form", class: "req" %><%= form.select :payment_form_id, PaymentForm.where(is_setoff: true).collect { |c| [c.name, c.id] }, { prompt: "Select Form" }, required: true %></div>
        <div class="zfield wide"><%= form.label :reason, "Reason", class: "req" %><%= form.text_area :reason, rows: 3, placeholder: "Enter reason for the setoff...", required: true %></div>
      </div>
    </section>
    <div class="zformfoot">
      <%= link_to "Cancel", invoice_path(inv), class: "b" %>
      <%= form.submit "Post Setoff", class: "b main", data: { turbo_confirm: "Are you sure you want to post this setoff?" } %>
    </div>
  <% end %>
</div>
