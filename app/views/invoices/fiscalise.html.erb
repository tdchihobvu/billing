<div class="zpage">
  <%= render "shared/zhead", title: "Fiscalise Invoice #{@invoice.invoice_number}", crumb: link_to("Sales / Invoices / #{@invoice.invoice_number}", invoice_path(@invoice)),
             sub: "Check the details, then save the proforma as a fiscal invoice." %>

  <%= form_for @invoice, url: save_fiscal_invoice_invoices_path(id: @invoice), html: { class: "box" } do |form| %>
    <%= render "shared/form_errors", record: @invoice %>
    <%= form.hidden_field :is_proforma %>

    <section class="zsect">
      <div class="boxh"><h2>Invoice</h2><span>Fields marked <span class="req"></span> are required</span></div>
      <div class="zgrid">
        <div class="zfield"><%= form.label :invoice_date, "Invoice Date", class: "req" %><%= form.date_field :invoice_date %></div>
        <div class="zfield"><%= form.label :invoice_number, "Invoice Number", class: "req" %><%= form.text_field :invoice_number, readonly: false %></div>
        <div class="zfield"><%= form.label :invoice_category_id, "Invoice Type", class: "req" %><%= form.select :invoice_category_id, InvoiceCategory.pluck(:name, :id), { prompt: "Select Type" } %></div>
        <div class="zfield wide"><%= form.label :client_id, "Client", class: "req" %><%= form.select :client_id, current_user.tenant.clients.order("name Asc").pluck(:name, :id), { include_blank: true } %></div>
        <div class="zfield"><%= form.label :currency_id, "Currency", class: "req" %><%= form.select :currency_id, Currency.pluck(:name, :id), { prompt: "Select Currency" } %></div>
        <div class="zfield"><%= form.label :bank_id, "Bank", class: "req" %><%= form.select :bank_id, tenant.banks.order("bank_name Asc").collect { |b| [b.description, b.id] }, { prompt: "Select Bank" } %></div>
        <div class="zfield wide">
          <span class="zlabel">Define Item Pricing</span>
          <div class="zchoices" role="radiogroup" aria-label="Define Item Pricing">
            <label><%= form.radio_button :product_pricing, "inclusive" %> Unit Price Includes VAT</label>
            <label><%= form.radio_button :product_pricing, "exclusive" %> Unit Price Excludes VAT</label>
            <label><%= form.radio_button :product_pricing, "none" %> No VAT</label>
          </div>
        </div>
        <div class="zfield wide"><%= form.label :description, "Invoice Description", class: "req" %><%= form.text_field :description %><span class="zhint">Appears on the client's statement.</span></div>
      </div>
    </section>

    <section class="zsect">
      <div class="boxh"><h2><span class="req">Invoice Items</span></h2></div>
      <div class="zwrap">
        <table class="zt zitems">
          <thead><tr><th>Description</th><th style="width:12%">Quantity</th><th style="width:16%">Unit Price</th><th style="width:22%">VAT Type</th></tr></thead>
          <tbody>
            <%= form.fields_for :invoice_items do |f| %>
              <tr>
                <td><%= f.text_area :description, rows: 2, placeholder: "Item Description", "aria-label": "Description" %></td>
                <td><%= f.number_field :quantity, "aria-label": "Quantity" %></td>
                <td><%= f.text_field :unit_price, inputmode: "decimal", "aria-label": "Unit Price" %></td>
                <td><%= f.select :vat_type_id, VatType.all.collect { |v| [v.description, v.id] }, { prompt: "Select Type" }, "aria-label": "VAT Type" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="zformfoot">
      <%= link_to "Cancel", invoice_path(@invoice), class: "b" %>
      <%= form.submit "Save Fiscal Invoice", class: "b main" %>
    </div>
  <% end %>
</div>
