<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Invoices</h1>
    <div class="float-end">
      <% if default_module == 'licensing' %>
        <%= link_to license_invoices_path, class: "d-none d-sm-inline-block btn btn-sm btn-outline text-dark" do %>
        <i class="fas fa-file fa-sm text-dark"></i> New Invoice
        <% end %> |
      <% else %>
        <%= link_to proforma_invoices_path, class: "d-none d-sm-inline-block btn btn-sm btn-outline text-dark" do %>
        <i class="fas fa-file fa-sm text-dark"></i> New Invoice
        <% end %> |
      <% end %>
      <%= link_to inactive_invoices_path, class: "d-none d-sm-inline-block btn btn-sm btn-outline text-dark" do %>
      <i class="fas fa-file fa-sm text-dark"></i> Inactive Invoices
      <% end %> |
      <%= link_to :back, class: "btn btn-outline btn-sm rounded-0" do %><i class="fas fa-backward text-dark"></i> Back <% end %> 
    </div>
</div>

<p style="color: green"><%= notice %></p>

<div class="card border-0">
  <div class="card-body">
    <div class="table-responsive">
      <%= render 'invoices' %>
    </div>
  </div>
</div>

<script type="text/javascript">
  $(document).ready(function() {
    $('#dataTable').DataTable();
  });
</script>
