<%
  inv = @invoice
  client = inv.client
  lic = inv.is_license ? inv.license : nil
  cur = inv.currency&.name
  balance = inv.invoice_balance.to_d
  total = inv.is_license ? (inv.discount_amount.positive? ? inv.total : lic.amount) : inv.total
  paid = total.to_d - balance
  pct = total.to_d.positive? ? [[(paid / total.to_d * 100).round, 0].max, 100].min : 0
  due = inv.effective_due_date(invoice_validity)
  receipts = inv.receipts.active.order(:transaction_date).preload(:payment_form, :user)
  events = []
  receipts.each { |r| events << [r.transaction_date.to_date, "g", "fa-check", "#{r.receipt_type.present? && r.receipt_type != 'payment' ? r.receipt_type.humanize : 'Paid'} #{r.currency&.name} #{number_with_precision(r.amount, precision: 2, delimiter: ',')} by #{r.payment_form&.name.to_s.downcase}", "Receipt #{r.reference_number} by #{r.user&.fullname || r.user_fullname}", receipt_path(r)] }
  events << [lic.renewal_date || inv.invoice_date, "m", "fa-stamp", "Licence issued", "#{lic.license_for}, valid #{lic.renewal_date&.strftime('%d %b %Y')} to #{lic.expiry_date&.strftime('%d %b %Y')}", nil] if lic&.expiry_date
  events << [inv.invoice_date, "", "fa-map-marker-alt", "Invoice raised", "By #{inv.user&.fullname || inv.user_fullname}#{inv.gps_latitude.present? ? ', location recorded' : ''}", nil]
  events << [inv.void_date || Date.today, "r", "fa-times", "Invoice voided", inv.void_reason.presence || "No reason given", nil] if inv.deleted? && inv.void?
  events.sort_by! { |e| e[0] || Date.new(1900) }.reverse!
%>
<div class="zpage">
  <div class="zhead">
    <div>
      <div class="zcrumb"><%= link_to "Sales / Invoices", invoices_path %></div>
      <h1><%= inv.invoice_number %></h1>
    </div>
    <div class="acts">
      <%= link_to print_invoices_path(id: inv, format: :pdf), class: "b", target: "_blank", rel: "noopener" do %><i class="fas fa-print" aria-hidden="true"></i> Print Invoice<% end %>
      <% unless inv.deleted? %>
        <%
          can_edit = can?("invoices.edit")
          more = []
          more << ["Edit", edit_invoice_path(inv)] if can_edit
          more << ["Assign Branches", assign_branches_invoices_path(id: inv)] if can_edit && client.branches.any?
          more << ["Setoff", setoff_invoice_path(inv)] if can_edit && balance.positive?
          more << ["New (duplicate)", duplicate_invoices_path(id: inv)] if can?("invoices.create")
          more += [:divider,
                   (["Delivery Note", delivery_note_invoices_path(id: inv, format: :pdf), { target: "_blank", rel: "noopener" }] unless inv.license),
                   ["Print slip (small printer)", receipt_invoices_path(id: inv)]].compact
          more << ["Fiscalise Invoice", fiscalise_invoices_path(id: inv)] if inv.is_proforma?
          more += [:divider, ["Trash", invoice_path(inv), { button: true, method: :delete, data: { turbo_confirm: "Move #{inv.invoice_number} to Inactive Invoices? It leaves the client's statement." } }]] if can?("invoices.delete")
        %>
        <% more.shift while more.first == :divider %>
        <%= zmore_menu(more) if more.any? %>
        <% if balance.positive? %>
          <%= link_to record_receipt_receipts_path(client_id: client.id), class: "b main" do %><i class="fas fa-dollar-sign" aria-hidden="true"></i> Record Receipt<% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if notice.present? %><div class="znote ok"><span><i class="fas fa-check" aria-hidden="true"></i></span><div><%= notice %></div></div><% end %>
  <% if inv.deleted? %>
    <div class="znote err"><span><i class="fas fa-times" aria-hidden="true"></i></span><div><b>This invoice is no longer active</b><%= inv.void_reason.presence || "It was moved to trash or voided." %> It doesn't count towards the client's balance or reports.</div></div>
  <% end %>

  <div class="zsplit">
    <section class="box zdoc" aria-label="Invoice">
      <div class="zdoctop">
        <div>
          <%= zstatus_tag(inv) %>
          <h2><%= link_to client.name, client %></h2>
          <small class="muted"><%= [client.address_1, client.address_2, client.location, client.city].compact_blank.join(", ") %></small>
        </div>
        <div class="zowed"><small class="muted">Balance</small><b><span class="cur"><%= cur %></span><%= number_with_precision(balance, precision: 2, delimiter: ",") %></b></div>
      </div>
      <div>
        <div class="ztrack" role="img" aria-label="<%= pct %>% paid"><i style="width:<%= pct %>%"></i></div>
        <small class="muted"><%= cur %> <%= number_with_precision(paid, precision: 2, delimiter: ",") %> of <%= number_with_precision(total, precision: 2, delimiter: ",") %> paid</small>
      </div>
      <div class="zfacts">
        <div><small>Invoice date</small><b><%= inv.invoice_date&.strftime("%d %b %Y") %></b></div>
        <div><small>Due</small><b><%= due&.strftime("%d %b %Y") %></b></div>
        <div><small><%= default_user_title %></small><b><%= inv.user&.fullname || inv.user_fullname %></b></div>
        <div><small>Document</small><b><%= inv.document.to_s.capitalize %></b></div>
      </div>

      <div class="zwrap">
        <table class="zt zlines">
          <thead><tr><th>HS Code</th><th>Description</th><th class="r">Unit Price</th><th class="r">Qty</th><th class="r">VAT</th><th class="r">Line Vat</th><th class="r">Line Total</th></tr></thead>
          <tbody>
            <% if lic %>
              <tr><td>1</td><td><%= lic.license_for %><%= ", #{lic.license_option.name}" if lic.license_option %></td><td class="r money"><%= number_with_precision(lic.unit_price, precision: 2, delimiter: ",") %></td><td class="r"><%= lic.quantity %></td><td class="r money"><%= number_with_precision(lic.vat, precision: 2, delimiter: ",") %></td><td class="r money"><%= number_with_precision(lic.line_vat, precision: 2, delimiter: ",") %></td><td class="r money"><%= number_with_precision(lic.amount, precision: 2, delimiter: ",") %></td></tr>
            <% else %>
              <% inv.invoice_items.active.each do |item| %>
                <tr><td><%= item.item_code %></td><td><%= item.description %></td><td class="r money"><%= number_with_precision(item.net_price, precision: 2, delimiter: ",") %></td><td class="r"><%= item.quantity %></td><td class="r money"><%= number_with_precision(item.vat, precision: 2, delimiter: ",") %></td><td class="r money"><%= number_with_precision(item.line_vat, precision: 2, delimiter: ",") %></td><td class="r money"><%= number_with_precision(item.line_total, precision: 2, delimiter: ",") %></td></tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <dl class="ztotals">
        <dt>Subtotal</dt><dd><%= number_with_precision(lic ? lic.sub_total : inv.sub_total, precision: 2, delimiter: ",") %></dd>
        <% if inv.discount_amount.positive? %><dt>Discount</dt><dd>-<%= number_with_precision(inv.discount_amount, precision: 2, delimiter: ",") %></dd><% end %>
        <dt>Tax</dt><dd><%= number_with_precision(lic && !inv.discount_amount.positive? ? lic.vat : inv.vat, precision: 2, delimiter: ",") %></dd>
        <dt class="tot">Total</dt><dd class="tot"><%= cur %> <%= number_with_precision(total, precision: 2, delimiter: ",") %></dd>
        <% receipts.each do |r| %><dt class="pay">Receipt <%= r.reference_number %></dt><dd class="pay">-<%= number_with_precision(r.amount_paid, precision: 2, delimiter: ",") %></dd><% end %>
        <dt class="tot">Balance</dt><dd class="tot"><%= cur %> <%= number_with_precision(balance, precision: 2, delimiter: ",") %></dd>
      </dl>

      <% if lic&.expiry_date %>
        <div class="zlic">
          <span class="zseal" aria-hidden="true"></span>
          <div><b>Licence issued with this invoice</b><small><%= lic.license_for %>, valid <%= lic.renewal_date&.strftime("%d %b %Y") %> to <%= lic.expiry_date.strftime("%d %b %Y") %></small></div>
          <% if lic.printable? %>
            <%= link_to "Print License", print_licenses_path(id: lic, format: :pdf), class: "zlink", target: "_blank", rel: "noopener" %>
          <% else %>
            <span style="display:grid;justify-items:end;gap:3px"><%= zlicense_approval_tag(lic) %><small class="muted" style="font-size:12px"><%= lic.approval_hint %></small></span>
          <% end %>
        </div>
      <% end %>

      <% if inv.banks.any? %>
        <div class="zbanks">
          <% inv.banks.each do |bank| %>
            <div><small>Bank</small><b><%= bank.bank_name %></b><span><%= bank.account_name %>, <%= bank.account_number %></span><span class="muted"><%= bank.branch %><%= ", Swift #{bank.swift_code}" if bank.swift_code.present? %></span></div>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="box" aria-labelledby="happened">
      <div class="boxh"><h2 id="happened">What happened</h2><span>newest first</span></div>
      <ul class="zfeed">
        <% events.each do |date, tone, icon, title, detail, url| %>
          <li>
            <span class="zdot <%= tone %>"><i class="fas <%= icon %>" aria-hidden="true"></i></span>
            <div><b><%= url ? link_to(title, url) : title %></b><small><%= detail %><%= ", #{date.strftime('%d %b %Y')}" if date %></small></div>
          </li>
        <% end %>
      </ul>
    </section>
  </div>
</div>
