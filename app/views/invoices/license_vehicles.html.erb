<%# The client's vehicles as tick boxes for a licence invoice (loaded into the form). %>
<%= turbo_frame_tag "license_vehicles" do %>
  <div class="zvehbox">
    <% if @client.nil? %>
      <p class="zvehnote">Choose the client to see their vehicles.</p>
    <% elsif @vehicles.empty? %>
      <div class="zvehempty">
        <i class="fas fa-bus" aria-hidden="true"></i>
        <div>
          <b><%= @client.name.squish %> has no vehicles</b>
          <span>Only vehicle licences need them. Add the client's buses or kombis first if this licence is for vehicles.</span>
        </div>
        <%= link_to client_path(@client, tab: "vehicles"), target: "_top", class: "b" do %><i class="fas fa-plus" aria-hidden="true"></i> Add vehicles<% end %>
      </div>
    <% else %>
      <%= hidden_field_tag "vehicle_ids[]", "", id: nil %>
      <div class="zvehbar">
        <p class="zvehnote">
          Tick the vehicles this licence covers. <b>No. of Licenses</b> follows the number ticked.
          Leave them all unticked if this licence isn't for vehicles.
          <% if @from_previous %><span class="zvehprev"><i class="fas fa-history" aria-hidden="true"></i> Ticked from the client's last licence of this category.</span><% end %>
        </p>
        <div class="zvehtools">
          <span class="zvehcount" data-vehicle-picker-target="counter" aria-live="polite"><%= @selected.size %> of <%= @vehicles.size %> ticked</span>
          <% if @vehicles.size > 1 %>
            <button type="button" class="b" data-action="vehicle-picker#all">Tick all</button>
            <button type="button" class="b" data-action="vehicle-picker#none">Clear</button>
          <% end %>
        </div>
      </div>
      <div class="zvehpick" role="group" aria-label="Vehicles this licence covers">
        <% @vehicles.each do |v| %>
          <label class="zvehcard" for="pick_vehicle_<%= v.id %>">
            <%= check_box_tag "vehicle_ids[]", v.id, @selected.include?(v.id), id: "pick_vehicle_#{v.id}", data: { action: "change->vehicle-picker#count" } %>
            <span class="zvehtext">
              <span class="zplate"><%= v.registration_number %></span>
              <small><%= v.make_model.presence || "Make not recorded" %></small>
            </span>
          </label>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
