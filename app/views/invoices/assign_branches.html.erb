<div class="zpage">
  <%= render "shared/zhead", title: "Assign Branches", crumb: link_to("Sales / Invoices / #{@invoice.invoice_number}", invoice_path(@invoice)),
             sub: "Choose which of #{@invoice.client.name}'s branches this invoice covers." %>

  <%= form_with(model: @invoice, class: "box") do |form| %>
    <%= render "shared/form_errors", record: @invoice %>
    <%= form.hidden_field :is_proforma %>
    <div class="boxh"><h2>Branches</h2><span><%= pluralize(@invoice.client.branches.size, "branch") %></span></div>
    <% if @invoice.client.branches.any? %>
      <%= form.collection_check_boxes(:branch_ids, @invoice.client.branches, :id, :name) do |b| %>
        <div class="zsetrow" style="grid-template-columns:auto minmax(0,1fr)">
          <%= b.check_box(class: "zbox") %>
          <%= b.label(style: "margin:0;font-weight:500;cursor:pointer") %>
        </div>
      <% end %>
    <% else %>
      <%= zempty("No branches", "This client has no branches yet.", link_to("Add branches", add_branches_clients_path(id: @invoice.client), class: "b")) %>
    <% end %>
    <div class="zformfoot">
      <%= link_to "Cancel", invoice_path(@invoice), class: "b" %>
      <%= form.submit "Save Invoice", class: "b main" %>
    </div>
  <% end %>
</div>
