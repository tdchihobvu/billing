<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Credit Notes</h1>
    <div class="float-end">
      <%= link_to credit_note_invoices_path, class: "d-none d-sm-inline-block btn btn-sm btn-outline text-dark" do %>
      <i class="fas fa-file fa-sm text-dark"></i> New Credit Note
      <% end %> |
      <%= link_to :back, class: "btn btn-outline btn-sm rounded-0" do %><i class="fas fa-backward text-dark"></i> Back <% end %> 
    </div>
</div>

<p style="color: green"><%= notice %></p>

<div class="card border-0">
  <div class="card-body">
    <% unless @credit_notes.empty? %>
    <table class="table table-striped small">
      <tr>
        <th>#</th>
        <th>Date</th>
        <th>Document No.</th>
        <th>Reference No.</th>
        <th>Reason</th>
        <th>User</th>
        <th>Total</th>
        <th></th>
      </tr>
      <% @credit_notes.each_with_index do |credit_note,i| %>
      <tr id="credit_notes">
        <td><%= i+=1 %></td>
        <td><%= credit_note.transaction_date.strftime("%d/%m/%Y") %></td>
        <td><%= credit_note.document_number %></td>
        <td><%= credit_note.reference_number %></td>
        <td><%= credit_note.reason %></td>
        <td><%= credit_note.user.firstname %></td>
        <td><%= number_to_currency(credit_note.invoice_amount, unit: "") %></td>
        <td><%= link_to "Print", print_credit_note_invoices_url(id: credit_note) %></td>
      </tr>
      <% end %>
    </table>
    <% else %>
    <div class="alert alert-warning text-center border-0" role="alert">There is nothing to display.</div>
    <% end %>
  </div>
</div>
