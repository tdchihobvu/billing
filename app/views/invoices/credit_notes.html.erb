<div class="zpage">
  <%= render "shared/zhead", title: "Credit Notes", crumb: link_to("Sales / Invoices", invoices_path),
             actions: link_to(credit_note_invoices_path, class: "b main") { safe_join([tag.i(class: "fas fa-plus", "aria-hidden": "true"), " New Credit Note"]) } %>

  <section class="box">
    <% if @credit_notes.any? %>
      <div class="zwrap">
        <table class="zt">
          <thead><tr><th>Document No.</th><th>Date</th><th>Reference No.</th><th>Reason</th><th>User</th><th class="r">Total</th><th><span class="visually-hidden">Print</span></th></tr></thead>
          <tbody>
            <% @credit_notes.each do |credit_note| %>
              <tr>
                <td class="zno"><%= credit_note.document_number %></td>
                <td class="money"><%= credit_note.transaction_date.strftime("%d %b %Y") %></td>
                <td><%= credit_note.reference_number %></td>
                <td><%= credit_note.reason %></td>
                <td><%= credit_note.user&.firstname %></td>
                <td class="r money"><%= number_to_currency(credit_note.invoice_amount, unit: "") %></td>
                <td style="text-align:right"><%= link_to print_credit_note_invoices_url(id: credit_note), class: "b" do %><i class="fas fa-print" aria-hidden="true"></i> Print<% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= zempty("No credit notes", "Credit notes you raise against invoices appear here.", link_to("New Credit Note", credit_note_invoices_path, class: "b main")) %>
    <% end %>
  </section>
</div>
