<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">New License Invoice</h1>
    <div class="float-end">
      <%= link_to invoices_path, class: "d-none d-sm-inline-block btn btn-sm btn-outline text-dark" do %>
      <i class="fas fa-file fa-sm text-dark"></i> Invoices
      <% end %> |
      <%= link_to :back, class: "btn btn-outline btn-sm rounded-0" do %><i class="fas fa-backward text-dark"></i> Back <% end %> 
    </div>
</div>

<p style="color: green"><%= notice %></p>

<div class="card border-0">
  <div class="card-body">
  <h6>All fields marked with <span class="required_field"></span> are mandatory</h6>
  <%= form_with(model: @invoice) do |form| %>
    <% if @invoice.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(@invoice.errors.count, "error") %> prohibited this invoice from being saved:</h2>

        <ul>
          <% @invoice.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.hidden_field :is_proforma %>
    <div class="row">
      <div class="col-sm-4">
       <div class="form-group">
          <%= form.label :invoice_date, "Invoice Date", style: "display: block", class: "required_field" %>
          <%= form.date_field :invoice_date, class: "form-control form-control-sm" %>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="form-group">
          <%= form.label :invoice_number, "Invoice Number", style: "display: block", class: "required_field" %>
          <%= form.text_field :invoice_number, readonly: true, class: "form-control form-control-sm" %>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="form-group">
          <%= form.label :invoice_category_id, "Invoice Type", style: "display: block", class: "required_field" %>
          <%= form.select :invoice_category_id, InvoiceCategory.where(id: 2).pluck(:name, :id), {prompt: "Select Type"}, class: "form-select form-control-sm" %>
        </div>
      </div>
    </div>
    <div class="form-group">
      <%= form.label :client_id, style: "display: block", class: "required_field" %>
      <%= form.select :client_id, current_user.tenant.clients.order('name Asc').pluck(:name, :id), {include_blank: true}, {data: {controller: 'slim'}, class: "small"} %>
      <%#= form.select :client_id, current_user.tenant.clients.order('name Asc').pluck(:name, :id), {prompt: 'Select Client'},class: "form-select form-control-sm" %>
    </div>

    <div class="form-group">
      <%= form.label :currency_id, style: "display: block", class: "required_field" %>
      <%= form.select :currency_id, Currency.pluck(:name, :id), {prompt: "Select Currency"},class: "form-select form-control-sm" %>
    </div>

    <div class="form-group">
      <strong><%= form.label :product_pricing, "Define Item Pricing", style: "display: block" %></strong>
      <%= form.radio_button :product_pricing, 'none' %> No VAT &nbsp;&nbsp; <%= form.radio_button :product_pricing, 'inclusive' %> Unit Price Includes VAT &nbsp;&nbsp; <%= form.radio_button :product_pricing, 'exclusive' %> Unit Price Excludes VAT  
    </div>

    <div class="form-group">
      <%= form.label :description, "Invoice Description (appears on the statement)", style: "display: block", class: "required_field" %>
      <%= form.text_area :description, class: "form-control form-control-sm" %>
    </div>

    <h6 class="required_field"><strong>License Details</strong></h6>
    <p></p>

    <div class="row">
      <%= form.fields_for :license do |f| %>
        <div class="form-group">
          <%= f.label :license_category_id, style: "display: block" %>
          <%= f.select :license_category_id, LicenseCategory.all.collect {|a| [a.name, a.id]}, {prompt: "Select Category"},class: "form-select form-control-sm" %>
        </div>

        <div class="form-group">
          <%= f.label :renewal_date, style: "display: block" %>
          <%= f.date_field :renewal_date, class: "form-control form-control-sm" %>
        </div>

        <div class="form-group">
          <%= f.label :amount, "Invoice Amount", style: "display: block" %>
          <%= f.text_field :amount, class: "form-control form-control-sm" %>
        </div>

        <div class="form-group">
          <%= f.label :quantity, "No. of Licenses", style: "display: block" %>
          <%= f.text_field :quantity, class: "form-control form-control-sm" %>
        </div>

        <div class="form-group">
          <%= f.label :auto_renewal, style: "display: block" %>
          <%= f.check_box :auto_renewal %>
        </div>

        <div class="form-group">
          <%= f.label :license_option_id, style: "display: block" %>
          <% LicenseOption.active.each do |o| %>
            <div class="form-check form-check-inline">
              <%= f.radio_button :license_option_id, o.id, class: "form-check-input" %> 
              <label class="form-check-label" for="inlineRadio1"><%= o.name %></label>
            </div>
          <% end %>
        </div>

        <div class="form-group">
          <%= f.label :special_days, "Days Must be filled for Special License Only", style: "display: block" %>
          <%= f.number_field :special_days, class: "form-control form-control-sm" %>
        </div>
      <% end %>
    </div>
    <div class="text-center">
      <%= form.submit "Save Invoice", class:'btn btn-lg btn-success' %>
    </div>
  <% end %>

  </div>
</div>