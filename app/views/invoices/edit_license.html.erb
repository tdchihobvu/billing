<div class="zpage">
  <div class="zhead">
    <div>
      <div class="zcrumb"><%= link_to "Sales / Invoices", invoices_path %></div>
      <h1>Edit License Invoice <%= @invoice.invoice_number %></h1>
      <p>Fields marked <span class="req"></span> are required.</p>
    </div>
    <div class="acts"><%= link_to "Back to invoice", @invoice, class: "b" %></div>
  </div>

  <% if notice.present? %><div class="znote ok"><span><i class="fas fa-check" aria-hidden="true"></i></span><div><%= notice %></div></div><% end %>

  <%= render "license_form", invoice: @invoice %>
</div>
