<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Billing Menu</h1>
    <a href="#" class="d-none d-sm-inline-block btn btn-sm btn-info shadow-sm border-0"><i
            class="fas fa-chart-line"></i> View Dashboard</a>
</div>

<div class="card border-0">
    <div class="card-body">
        <div class="row">
            <div class="col-sm-12">
                <%= link_to upcoming_renewals_reports_path do %>
                     Upcoming Renewals <i class="fas fa-caret-down"></i></a>
                <% end %>
            </div>
        </div>
    </div>
    <div class="card-body">
        <% if default_module == 'licensing' %>
        <div class="row">
            <div class="col-sm-4">
                <%= link_to license_invoices_path, class: "btn btn-outline-primary btn-sm btn-block shadow-sm mb-2 border-2" do %>
                    <i class="fas fa-file-invoice-dollar fa-lg py-4"></i> &nbsp; New Sales Invoice
                <% end %>
            </div>
            <div class="col-sm-4">
                <%= link_to new_receipt_path, class: "btn btn-outline-warning btn-sm btn-block shadow-sm mb-2 border-2" do %>
                    <i class="fas fa-dollar-sign fa-lg py-4"></i> &nbsp; Record Receipt
                <% end %>
            </div>
            <div class="col-sm-4">
                <%= link_to new_license_path, class: "btn btn-outline-success btn-sm btn-block shadow-sm mb-2 border-2" do %>
                    <i class="fas fa-receipt fa-lg py-4"></i> &nbsp; Generate License
                <% end %>
            </div>
        </div>
        <% else %>
        <div class="row">
            <div class="col-sm-3">
                <%= link_to new_quotation_path, class: "btn btn-outline-success btn-sm btn-block shadow-sm mb-2 border-2" do %>
                    <i class="fas fa-file-invoice fa-lg py-4"></i> &nbsp; New Quotation
                <% end %>
            </div>
            <div class="col-sm-3">
                <%= link_to proforma_invoices_path, class: "btn btn-outline-secondary btn-sm btn-block shadow-sm mb-2 border-2" do %>
                    <i class="fas fa-file-invoice-dollar fa-lg py-4"></i> &nbsp; New Proforma
                <% end %>
            </div>
            <div class="col-sm-3">
                <%= link_to new_invoice_path, class: "btn btn-outline-primary btn-sm btn-block shadow-sm mb-2 border-2" do %>
                    <i class="fas fa-file-invoice-dollar fa-lg py-4"></i> &nbsp; New Sales Invoice
                <% end %>
            </div>
            <div class="col-sm-3">
                <%= link_to new_receipt_path, class: "btn btn-outline-warning btn-sm btn-block shadow-sm mb-2 border-2" do %>
                    <i class="fas fa-dollar-sign fa-lg py-4"></i> &nbsp; Record Receipt
                <% end %>
            </div>
        </div>
        <% end %>
        <div class="row">
        </div>
    </div>
    <div class="row">
        <div class="col-lg-6 d-flex flex-column">
            <div class="card border-0">
              <div class="card-body">
                <div class="row">
                  <div class="col-lg-12">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                      <div>
                        <h6 class="card-title card-title-dash">Sales & Collections By <%= default_user_title %> - <%= "#{@start_date.to_date.strftime("%d/%m/%Y")} To #{@end_date.to_date.strftime("%d/%m/%Y")}" %></h6>
                      </div>
                    </div>
                    <div class="mt-3">
                      <%= render 'chart_by_inspector' %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
        </div>

        <div class="col-lg-6 d-flex flex-column">
            <div class="card border-0">
              <div class="card-body">
                <div class="row">
                  <div class="col-lg-12">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                      <div>
                        <h6 class="card-title card-title-dash">Collections By Month - <%= "#{@from.to_date.strftime("%d/%m/%Y")} To #{@to.to_date.strftime("%d/%m/%Y")}" %></h6>
                      </div>
                    </div>
                    <div class="mt-3">
                      <%= column_chart Receipt.active.where(transaction_date: @from.to_date..@to.to_date).group(:user_fullname).sum(:actual_paid) %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
        </div>
    </div>
</div>
