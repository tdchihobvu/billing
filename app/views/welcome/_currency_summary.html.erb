<div class="card border-0 shadow-sm mt-4">
  <div class="card-body">

    <h5 class="mb-3">Financial Summary by Currency</h5>

    <div class="table-responsive">
      <table class="table table-hover align-middle">

        <thead>
          <tr>
            <th>Currency</th>
            <th>Invoices</th>
            <th>Total Invoiced</th>
            <th>Collected</th>
            <th>Outstanding</th>
            <th>Collection Rate</th>
          </tr>
        </thead>

        <tbody>
          <% @financial_summary.each do |item| %>

            <% rate = item[:total_invoiced].to_d.zero? ? 0 : (item[:total_paid].to_d / item[:total_invoiced].to_d * 100).round(2) %>

            <tr>
              <td><%= item[:currency] %></td>
              <td><%= item[:invoice_count] %></td>

              <td>
                <%= number_with_delimiter(item[:total_invoiced]) %>
              </td>

              <td class="text-success">
                <%= number_with_delimiter(item[:total_paid]) %>
              </td>

              <td class="text-danger">
                <%= number_with_delimiter(item[:outstanding_balance]) %>
              </td>

              <td>
                <div class="progress" style="height: 8px;">
                  <div
                    class="progress-bar bg-success"
                    style="width: <%= [rate, 100].min %>%">
                  </div>
                </div>
                <small><%= rate %>%</small>
              </td>
            </tr>

          <% end %>
        </tbody>

      </table>
    </div>

  </div>
</div>