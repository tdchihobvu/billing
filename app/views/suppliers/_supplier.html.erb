<div id="<%= dom_id supplier %>">
  <p>
    <strong>Name:</strong>
    <%= supplier.name %>
  </p>

  <p>
    <strong>Vat number:</strong>
    <%= supplier.vat_number %>
  </p>

  <p>
    <strong>Bp number:</strong>
    <%= supplier.bp_number %>
  </p>

  <p>
    <strong>Address 1:</strong>
    <%= supplier.address_1 %>
  </p>

  <p>
    <strong>Address 2:</strong>
    <%= supplier.address_2 %>
  </p>

  <p>
    <strong>Location:</strong>
    <%= supplier.location %>
  </p>

  <p>
    <strong>Country:</strong>
    <%= supplier.country %>
  </p>

  <p>
    <strong>Phone:</strong>
    <%= supplier.phone %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= supplier.email %>
  </p>

  <p>
    <strong>Contact person:</strong>
    <%= supplier.contact_person %>
  </p>

  <p>
    <strong>Contact mobile:</strong>
    <%= supplier.contact_mobile %>
  </p>

  <p>
    <strong>Active:</strong>
    <%= supplier.active %>
  </p>

</div>
