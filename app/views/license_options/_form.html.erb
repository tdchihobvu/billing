<%= form_with(model: license_option) do |form| %>
  <% if license_option.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(license_option.errors.count, "error") %> prohibited this license_option from being saved:</h2>

      <ul>
        <% license_option.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :count_by, style: "display: block" %>
    <div class="form-check form-check-inline">
      <%= form.radio_button :count_by, 'months', checked: true, class: "form-check-input" %>
      <label class="form-check-label" for="inlineRadio1">Months</label>
    </div>
    <div class="form-check form-check-inline">
      <%= form.radio_button :count_by, 'days', class: "form-check-input" %>
      <label class="form-check-label" for="inlineRadio1">Days</label>
    </div>
  </div>

  <div>
    <%= form.label :months, "Enter Value", style: "display: block" %>
    <%= form.number_field :months %>
  </div>

  <div>
    <%= form.label :active, style: "display: block" %>
    <%= form.check_box :active %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
