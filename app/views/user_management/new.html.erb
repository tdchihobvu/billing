<div class="zpage">
  <%= render "shared/zhead", title: "New user", crumb: link_to("Administration / Users", user_management_index_path),
             sub: "They get a temporary password and must change it when they first sign in." %>

  <%= form_for @user, url: save_user_management_index_path, html: { class: "box" } do |f| %>
    <%= render "shared/form_errors", record: @user %>

    <section class="zsect">
      <div class="boxh"><h2>Details</h2><span>Fields marked <span class="req"></span> are required</span></div>
      <div class="zgrid">
        <div class="zfield"><%= f.label :firstname, "First name", class: "req" %><%= f.text_field :firstname, autofocus: true %></div>
        <div class="zfield"><%= f.label :lastname, "Last name", class: "req" %><%= f.text_field :lastname %></div>
        <div class="zfield"><%= f.label :username, class: "req" %><%= f.text_field :username, autocomplete: "off" %></div>
        <div class="zfield"><%= f.label :email %><%= f.email_field :email, autocomplete: "email" %></div>
      </div>
    </section>

    <%= render "role_picker", f: f %>

    <section class="zsect">
      <div class="boxh"><h2>Temporary password</h2><span><%= User::PASSWORD_RULES %></span></div>
      <div class="zgrid">
        <div class="zfield"><%= f.label :password, class: "req" %><%= f.password_field :password, autocomplete: "new-password" %></div>
        <div class="zfield"><%= f.label :password_confirmation, "Confirm password", class: "req" %><%= f.password_field :password_confirmation, autocomplete: "new-password" %></div>
      </div>
    </section>

    <div class="zformfoot">
      <%= link_to "Cancel", user_management_index_path, class: "b" %>
      <%= f.submit "Save User", class: "b main" %>
    </div>
  <% end %>
</div>
