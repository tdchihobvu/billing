<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">User Management</h1>
    <%= link_to new_user_management_path,  class: "d-none d-sm-inline-block btn  btn-sm btn-outline text-dark" do %>
    	<i class="fas fa-user-tie fa-sm text-dark"></i> New User</a>
    <% end %>
</div>

<div class="card">
    <div class="card-body">
        <% unless @users.empty? %>
        <table id="dataTable" class="table table-striped small" width="100%" cellspacing="0">
          <thead>
            <tr>
              <th>#</th>
              <th>Firstname</th>
              <th>Lastname</th>
              <th>Username</th>
              <th>Email</th>
              <th>Role</th>
              <th>Last Signed at</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @users.each_with_index do |user,i| %>
            <tr id="users">
              <td><%= i+=1 %></td>
              <td><%= user.firstname %></td>
              <td><%= user.lastname %></td>
              <td><%= user.username %></td>
              <td><%= user.email %></td>
              <td><%= user.role %></td>
              <td><%= user.last_sign_in_at.strftime("%d/%m/%Y %H:%M") unless user.last_sign_in_at.nil? %></td>
              <td>
                <%= link_to details_user_management_index_path(id: user), class: "btn btn-outline text-dark small", title: "User Details" do %>
                  <i class="fas fa-eye fa-sm text-dark"></i>
                <% end %>
                <% if current_user.role == 'superadmin' %>
                  <%= link_to edit_user_management_index_path(id: user), class: "btn btn-outline text-dark small", title: "Edit Details" do %>
                    <i class="fas fa-edit fa-sm text-dark"></i>
                  <% end %>
                <% end %>
              </td>
            </tr>
            <% end %>
          </tbody>
        </table>
        <% else %>
        <div class="alert alert-warning text-center border-0" role="alert">There is nothing to display.</div>
        <% end %>
    </div>
</div>

<script type="text/javascript">
  $(document).ready(function() {
    $('#dataTable').DataTable();
  });
</script>