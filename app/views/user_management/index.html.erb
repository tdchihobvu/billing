<%
  roles_by_key = @roles.index_by(&:key)
  label_for = ->(role) { (roles_by_key[role]&.name || role.to_s.humanize).pluralize }
  hint_for = ->(role) { roles_by_key[role]&.description.to_s.truncate(70) }
  manage = can?("users.manage")
%>

<div class="zpage" data-controller="people-filter" data-people-filter-role="<%= @role %>">
  <%= render "shared/zhead", title: "Users", sub: "#{pluralize(@total_users, 'user')} across #{pluralize(@users_by_role.size, 'role')}",
             actions: safe_join([
               (can?("roles.manage") ? link_to(roles_path, class: "b") { safe_join([tag.i(class: "fas fa-user-shield", "aria-hidden": "true"), " Roles and permissions"]) } : nil),
               (manage ? link_to(new_user_management_path, class: "b main") { safe_join([tag.i(class: "fas fa-plus", "aria-hidden": "true"), " New user"]) } : nil)
             ].compact) %>

  <div class="zroles" role="group" aria-label="Filter by role">
    <%= link_to user_management_index_path, class: "zrole", data: { role: "all", people_filter_target: "tab", action: "people-filter#selectRole" }, aria: { pressed: @role == "all" } do %>
      <b>Everyone</b><strong><%= @total_users %></strong><small>All roles</small>
    <% end %>
    <% @users_by_role.each do |role, users| %>
      <%= link_to user_management_index_path(role: role), class: "zrole", data: { role: role, people_filter_target: "tab", action: "people-filter#selectRole" }, aria: { pressed: @role == role } do %>
        <b><%= label_for.(role) %></b><strong><%= users.size %></strong><small><%= hint_for.(role) %></small>
      <% end %>
    <% end %>
  </div>

  <section class="box">
    <div class="zfilters">
      <label class="zsearch"><span class="visually-hidden">Search users</span><i class="fas fa-search" aria-hidden="true"></i>
        <input type="search" placeholder="Name or email" autocomplete="off" data-people-filter-target="query" data-action="input->people-filter#apply"></label>
      <div class="right muted" style="font-size:12.5px" data-people-filter-target="showing" aria-live="polite"><%= pluralize(@total_users, "person") %></div>
    </div>

    <% @users_by_role.each do |role, users| %>
      <% users.each do |user| %>
        <% name = user.fullname.strip.presence || user.username %>
        <% seen = user.last_sign_in_at %>
        <% days = seen ? (Date.current - seen.to_date).to_i : nil %>
        <div class="zperson" data-people-filter-target="person" data-role="<%= role %>"
             data-search="<%= [name, user.username, user.email].compact.join(' ').downcase %>">
          <span class="zav" aria-hidden="true"><%= zinitials(name) %></span>
          <div><b><%= link_to name, details_user_management_index_path(id: user) %></b><small>@<%= user.username %><%= " · #{user.email}" if user.email.present? %></small></div>
          <div><b style="font-weight:500"><%= days.nil? ? "Never" : days.zero? ? "Today" : days == 1 ? "Yesterday" : "#{days} days ago" %></b><small>Last signed in</small></div>
          <div class="acts">
            <% if user.locked_at.present? %><span class="ztag late">Locked</span><% end %>
            <% if user.must_change_password %><span class="ztag part">Must change password</span><% end %>
            <% if days && days <= 30 %><span class="ztag paid">Active</span><% else %><span class="ztag">Inactive</span><% end %>
            <span class="ztag info"><%= role_label(role) %></span>
            <% if manage && (current_user.superadmin? || !user.superadmin?) %>
              <%= link_to "Edit", edit_user_management_index_path(id: user), class: "b" %>
              <%= link_to "Reset password", reset_user_management_index_path(id: user), class: "b", data: { turbo_confirm: "Reset the password for #{user.username}? They will need the temporary password to sign in." } %>
            <% else %>
              <%= link_to "View", details_user_management_index_path(id: user), class: "b" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <div data-people-filter-target="empty" hidden><%= zempty("No one matches that search", "Try part of a name or email.") %></div>
  </section>
</div>
