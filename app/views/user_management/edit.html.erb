<div class="zpage">
  <%= render "shared/zhead", title: "Update Details", crumb: link_to("Administration / Users", user_management_index_path),
             sub: @user.fullname,
             actions: link_to("View user", details_user_management_index_path(id: @user), class: "b") %>

  <%= form_for @user, url: save_user_management_index_path, html: { class: "box" } do |f| %>
    <%= render "shared/form_errors", record: @user %>
    <%= f.hidden_field :id %>

    <section class="zsect">
      <div class="boxh"><h2>Details</h2></div>
      <div class="zgrid">
        <div class="zfield"><%= f.label :firstname, "First name" %><%= f.text_field :firstname, autofocus: true %></div>
        <div class="zfield"><%= f.label :lastname, "Last name" %><%= f.text_field :lastname %></div>
        <% if @user.devices.empty? %>
          <div class="zfield"><%= f.label :username %><%= f.text_field :username, autocomplete: "off" %></div>
        <% else %>
          <div class="zfield"><span class="zlabel">Username</span><input type="text" value="<%= @user.username %>" disabled aria-label="Username"><span class="zhint">Can't change: this user is linked to a device.</span></div>
        <% end %>
        <div class="zfield"><%= f.label :email %><%= f.email_field :email, autocomplete: "email" %></div>
      </div>
    </section>

    <% if @user == current_user %>
      <section class="zsect"><div class="boxh"><h2>Role</h2></div>
        <p style="padding:0 18px 16px;margin:0"><b><%= role_label(@user.role) %></b>. <span class="muted">You can't change your own role. Ask another Super admin.</span></p></section>
    <% else %>
      <%= render "role_picker", f: f %>
    <% end %>

    <div class="zformfoot">
      <%= link_to "Cancel", user_management_index_path, class: "b" %>
      <%= f.submit "Update User", class: "b main" %>
    </div>
  <% end %>
</div>
