<div id="<%= dom_id exchange_rate %>">
  <p>
    <strong>Currency:</strong>
    <%= exchange_rate.currency.name %>
  </p>

  <p>
    <strong>Transaction date:</strong>
    <%= exchange_rate.transaction_date %>
  </p>

  <p>
    <strong>Buying rate:</strong>
    <%= exchange_rate.buying_rate %>
  </p>

  <p>
    <strong>Midrate:</strong>
    <%= exchange_rate.midrate %>
  </p>

  <p>
    <strong>Selling rate:</strong>
    <%= exchange_rate.selling_rate %>
  </p>

  <p>
    <strong>Alternative rate:</strong>
    <%= exchange_rate.alternative_rate %>
  </p>

  <p>
    <strong>User:</strong>
    <%= exchange_rate.user.user_fullname %>
  </p>

</div>
