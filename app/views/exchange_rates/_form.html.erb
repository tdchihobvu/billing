<%= form_with(model: exchange_rate) do |form| %>
  <% if exchange_rate.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(exchange_rate.errors.count, "error") %> prohibited this exchange_rate from being saved:</h2>

      <ul>
        <% exchange_rate.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group row">
    <div class="col-2">
      <%= form.date_field :transaction_date, class: "form-control form-control-sm"  %>
    </div>
    <div class="col-2">
      <%= form.select :currency_id, Currency.non_base.pluck(:name, :id), {prompt: "Select Currency"}, class: "form-select form-select-sm" %>
    </div>
    <div class="col-3">
      <%= form.text_field :selling_rate, placeholder: 'Selling Rate', class: "form-control form-control-sm", required: true %>
    </div>
    <div class="col-3">
      <%= form.text_field :alternative_rate, placeholder: 'Alternative Rate', class: "form-control form-control-sm", required: true %>
    </div>
    <div class="col-2">
      <%= form.submit "Submit", class: 'btn btn-primary btn-sm' %>
    </div>
  </div>
<% end %>
