<%= form_with(model: exchange_rate, class: "box") do |form| %>
  <%= render "shared/form_errors", record: exchange_rate %>
  <section class="zsect">
    <div class="boxh"><h2>Exchange rate</h2><span>Fields marked <span class="req"></span> are required</span></div>
    <div class="zgrid">
      <div class="zfield"><%= form.label :transaction_date, "Transaction Date", class: "req" %><%= form.date_field :transaction_date %></div>
      <div class="zfield"><%= form.label :currency_id, "Currency", class: "req" %><%= form.select :currency_id, Currency.non_base.pluck(:name, :id), { prompt: "Select Currency" } %></div>
      <div class="zfield"><%= form.label :selling_rate, "Selling Rate", class: "req" %><%= form.text_field :selling_rate, required: true, inputmode: "decimal" %></div>
      <div class="zfield"><%= form.label :alternative_rate, "Alternative Rate", class: "req" %><%= form.text_field :alternative_rate, required: true, inputmode: "decimal" %></div>
    </div>
  </section>
  <div class="zformfoot">
    <%= link_to "Cancel", (exchange_rate.persisted? ? exchange_rate_path(exchange_rate) : exchange_rates_path), class: "b" %>
    <%= form.submit "Submit", class: "b main" %>
  </div>
<% end %>
