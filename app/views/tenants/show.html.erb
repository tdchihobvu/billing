<p style="color: green"><%= notice %></p>

<%= render @tenant %>

<h3>Available Modules</h3>
<% if @tenant.system_modules.empty? %>
  <%= render "modules_form", tenant: @tenant %>
<% else %>
  <%= render 'tenant_modules' %>
<% end %>

<div>
  <%= link_to "Edit this tenant", edit_tenant_path(@tenant) %> |
  <%= link_to "Back to tenants", tenants_path %>

  <%#= button_to "Destroy this tenant", @tenant, method: :delete %>
</div>
