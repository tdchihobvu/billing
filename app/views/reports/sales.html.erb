<div class= "row">
  <div class="col-md-12">
    <!-- Filter Form -->
    <div class="card">
      <div class="card-body">
        <%= form_with url: sales_reports_path, method: :get, local: true do %>
        <div class="form-group row">
          <div class="col-2">
            <%= label_tag :start_date, 'Filter From:', class: 'form-label small' %>
            <%= date_field_tag :start_date, params[:start_date], class: 'form-control form-control-sm' %>
          </div>
          <div class="col-2">
            <%= label_tag :end_date, 'To:', class: 'form-label small' %>
            <%= date_field_tag :end_date, params[:end_date], class: 'form-control form-control-sm' %>
          </div>
          <div class="col-3">
            <%= label_tag :currency_id, 'Filter By Currency', class: 'form-label small' %>
            <%= select_tag :currency_id, options_from_collection_for_select(Currency.all, :id, :name, params[:currency_id]), {prompt: "Select Currency", class:"form-select form-select-sm" } %>
          </div>
          <div class="col-3">
            <%= label_tag :user_id, "Filter By #{default_user_title}", class: 'form-label small' %>
            <%= select_tag :user_id, options_from_collection_for_select(@users, :id, :user_fullname, params[:user_id]), {prompt: "Select #{default_user_title}", class:"form-select form-select-sm" } %>
          </div>
          <div class="col-2">
            <%= submit_tag "Submit", class: 'btn btn-primary btn-sm mt-4 p-2' %>
          </div>
        </div>
        <% end %>
      </div>
    </div>
  </div>

</div>

<div class="row mt-3">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <div class="float-right mb-2">
          <%= link_to sales_reports_path(start_date: @start_date, end_date: @end_date, currency_id: @currency, user_id: @user, format: :xlsx), class: "btn btn-primary btn-sm rounded-0" do %><i class="fas fa-file"></i> Export <% end %>
          <%= link_to vat_sales_reports_path(start_date: @start_date, end_date: @end_date, currency_id: @currency, user_id: @user, format: :xlsx), class: "btn btn-primary btn-sm rounded-0" do %><i class="fas fa-file"></i> VAT Sales <% end %>
          <%= link_to sales_by_user_reports_path(start_date: @start_date, end_date: @end_date, currency_id: @currency, format: :xlsx), class: "btn btn-primary btn-sm rounded-0" do %><i class="fas fa-file"></i> Export By <%= default_user_title %> <% end %>
        </div>  
        <%= render 'chart_by_inspector' %>
      </div>
    </div>
  </div>
</div>