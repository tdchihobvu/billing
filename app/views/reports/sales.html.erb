<% exp = { start_date: @start_date, end_date: @end_date, currency_id: @currency, user_id: @user, format: :xlsx } %>
<div class="zpage">
  <%= render "shared/zhead", title: "Sales", crumb: link_to("Reports", reports_path),
             actions: safe_join([
               link_to("Export By #{default_user_title}", sales_by_user_reports_path(exp.except(:user_id)), class: "b"),
               link_to("VAT Sales", vat_sales_reports_path(exp), class: "b"),
               link_to("Export", sales_reports_path(exp), class: "b main")
             ]) %>

  <%= render "report_filters", url: sales_reports_path, from_key: :start_date, to_key: :end_date %>

  <section class="box">
    <div class="boxh"><h2>By <%= default_user_title %></h2><span><%= @start_date.to_date.strftime("%d %b %Y") %> to <%= @end_date.to_date.strftime("%d %b %Y") %></span></div>
    <% if @by_user.any? %>
      <div class="zwrap"><table class="zt">
        <thead><tr><th><%= default_user_title %></th><th class="r">Invoices</th><% @currencies.each do |c| %><th class="r"><%= c.name %></th><% end %></tr></thead>
        <tbody>
          <% @by_user.each do |name, count, totals| %>
            <tr><td><%= name %></td><td class="r"><%= count %></td><% @currencies.each do |c| %><td class="r money"><%= totals[c.id] ? number_with_precision(totals[c.id], precision: 2, delimiter: ",") : "" %></td><% end %></tr>
          <% end %>
        </tbody>
      </table></div>
    <% else %>
      <%= zempty("No invoices in this period", "Invoices appear here as they're raised.") %>
    <% end %>
  </section>

  <section class="box">
    <div class="boxh"><h2>By licence category</h2></div>
    <% if @by_category.any? %>
      <div class="zwrap"><table class="zt">
        <thead><tr><th>Licence category</th><% @currencies.each do |c| %><th class="r"><%= c.name %></th><% end %></tr></thead>
        <tbody>
          <% @by_category.each do |name, totals| %>
            <tr><td><%= name %></td><% @currencies.each do |c| %><td class="r money"><%= totals[c.id] ? number_with_precision(totals[c.id], precision: 2, delimiter: ",") : "" %></td><% end %></tr>
          <% end %>
        </tbody>
      </table></div>
    <% else %>
      <%= zempty("No licences invoiced in this period", "Licence invoices appear here by category.") %>
    <% end %>
  </section>
</div>
