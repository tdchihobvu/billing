<% exp = { from: @from, to: @to, currency_id: @currency, user_id: @user, format: :xlsx } %>
<div class="zpage">
  <%= render "shared/zhead", title: "Collections", crumb: link_to("Reports", reports_path),
             actions: safe_join([
               link_to("Export By User", collections_by_user_reports_path(exp.except(:user_id)), class: "b"),
               link_to("Export", collections_reports_path(exp), class: "b main")
             ]) %>

  <%= render "report_filters", url: collections_reports_path, from_key: :from, to_key: :to %>

  <% [["By Payment Form", "Payment Form", @by_form], ["By #{default_user_title}", default_user_title, @by_user]].each do |heading, label, rows| %>
    <section class="box">
      <div class="boxh"><h2><%= heading %></h2><span><%= @start_date.to_date.strftime("%d %b %Y") %> to <%= @end_date.to_date.strftime("%d %b %Y") %></span></div>
      <% if rows.any? %>
        <div class="zwrap"><table class="zt">
          <thead><tr><th><%= label %></th><th class="r">Receipts</th><% @currencies.each do |c| %><th class="r"><%= c.name %></th><% end %></tr></thead>
          <tbody>
            <% rows.each do |name, count, totals| %>
              <tr><td><%= name %></td><td class="r"><%= count %></td><% @currencies.each do |c| %><td class="r money"><%= totals[c.id] ? number_with_precision(totals[c.id], precision: 2, delimiter: ",") : "" %></td><% end %></tr>
            <% end %>
          </tbody>
        </table></div>
      <% else %>
        <%= zempty("No receipts in this period", "Payments appear here as they're received.") %>
      <% end %>
    </section>
  <% end %>
</div>
