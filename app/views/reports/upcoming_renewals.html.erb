<% title = default_user_title.presence || "Inspector" %>
<% ranges = @periods.transform_values { |(_, from, to)| [from.iso8601, to.iso8601] } %>
<% today = Date.current %>
<% keep = request.query_parameters.slice("user_id", "payment", "q") %>
<% tab_labels = { "next_30" => "Expiring licences", "next_7" => "Next 7 days", "next_90" => "Next 90 days", "expired_30" => "Expired, last 30 days" } %>

<div class="zpage">
  <%= render "shared/zhead", title: "Expiring licences", crumb: link_to("Reports", reports_path),
             sub: "#{pluralize(@licenses.size, 'licence')} expiring #{@start_date.strftime('%d %b %Y')} to #{@end_date.strftime('%d %b %Y')}",
             actions: link_to("Download Excel", upcoming_renewals_reports_path(request.query_parameters.merge(from: @start_date, to: @end_date, format: :xlsx).except("period")), data: { turbo: false }, class: "b main") %>

  <section class="box">
    <nav class="ztabs" aria-label="Period">
      <% ReportsController::REPORT_TABS.each do |key| %>
        <%= link_to upcoming_renewals_reports_path(keep.merge(period: key)), "aria-current": (@period == key ? "page" : nil) do %>
          <%= tab_labels[key] %><em><%= number_with_delimiter(@tab_counts[key]) %></em>
        <% end %>
      <% end %>
    </nav>

    <%= form_with url: upcoming_renewals_reports_path, method: :get, class: "zfilters",
                  data: { controller: "period-filter", period_filter_ranges_value: ranges.to_json, turbo_action: "advance" } do |f| %>
      <label class="zsearch"><span class="visually-hidden">Client</span><i class="fas fa-search" aria-hidden="true"></i>
        <%= f.search_field :q, value: params[:q], placeholder: "Client name" %></label>
      <%= f.select :period, options_for_select(@periods.map { |key, (label, *)| [label, key] } + [["Custom dates", "custom"]], @period),
                   {}, class: "zsel on", "aria-label": "Period", data: { period_filter_target: "period", action: "change->period-filter#pick" } %>
      <label class="zdate">From <%= f.date_field :from, value: @start_date, class: "zsel", data: { period_filter_target: "from", action: "change->period-filter#custom" } %></label>
      <label class="zdate">To <%= f.date_field :to, value: @end_date, class: "zsel", data: { period_filter_target: "to", action: "change->period-filter#custom" } %></label>
      <%= f.select :user_id, options_from_collection_for_select(@users, :id, :fullname, params[:user_id]), { include_blank: "All #{title.pluralize}" }, class: "zsel #{'on' if params[:user_id].present?}", "aria-label": title %>
      <%= f.select :payment, options_for_select([["Paid", "paid"], ["Not fully paid", "unpaid"]], params[:payment]), { include_blank: "Any payment" }, class: "zsel #{'on' if params[:payment].present?}", "aria-label": "Payment" %>
      <%= f.submit "Apply", name: nil, class: "b main" %>
      <%= link_to "Reset", upcoming_renewals_reports_path, class: "b" %>
    <% end %>

    <% if @licenses.any? %>
      <div class="zwrap">
        <table class="zt">
          <thead>
            <tr><th>Client</th><th>Licence</th><th>Valid period</th><th>Expires</th><th class="r">Last invoiced</th><th><%= title %></th><th><span class="visually-hidden">Open</span></th></tr>
          </thead>
          <tbody>
            <% @licenses.each do |license| %>
              <% client = license.client %>
              <% invoice = license.invoice %>
              <% address = [client.address_1, client.address_2, client.location, client.city].compact_blank.join(", ") %>
              <% days = (license.expiry_date - today).to_i %>
              <tr>
                <td class="zvn zclient"><%= link_to client.name, client, class: "zno" %><small title="<%= address %>"><%= address.presence || "No address on file" %></small></td>
                <td><%= license.license_for %><small class="muted" style="display:block"><%= license.license_option&.name %></small></td>
                <td><%= license.renewal_date ? "#{license.renewal_date.strftime('%d %b %Y')} –#{license.expiry_date.strftime('%d %b %Y')}" : "Until #{license.expiry_date.strftime('%d %b %Y')}" %></td>
                <td>
                  <% if days < 0 %><span class="ztag late">Expired <%= pluralize(-days, "day") %> ago</span>
                  <% elsif days == 0 %><span class="ztag late">Expires today</span>
                  <% elsif days <= 7 %><span class="ztag part">In <%= pluralize(days, "day") %></span>
                  <% else %><span class="ztag">In <%= pluralize(days, "day") %></span><% end %>
                </td>
                <td class="r money"><span class="cur"><%= invoice.currency.name %></span> <%= number_with_precision(invoice.invoice_total.to_d.round(2), precision: 2, delimiter: ",") %><div style="margin-top:4px"><%= zstatus_tag(invoice) %></div></td>
                <td><%= invoice.user&.fullname || invoice.user_fullname %></td>
                <td><%= link_to invoice, class: "b", title: "Open invoice #{invoice.invoice_number}" do %><i class="fas fa-arrow-right" aria-hidden="true"></i><span class="visually-hidden">Open invoice <%= invoice.invoice_number %></span><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= zempty("No licences in this period", "Change the tab or the dates to see other licences.") %>
    <% end %>
  </section>

  <% if @totals.any? %>
    <div class="zstats">
      <% @totals.sort.each do |currency, amount| %>
        <div class="zstat"><small>Previously invoiced (<%= currency %>)</small><b><%= number_with_precision(amount.round(2), precision: 2, delimiter: ",") %></b></div>
      <% end %>
    </div>
  <% end %>
</div>
