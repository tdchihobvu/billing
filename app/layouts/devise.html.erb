<!DOCTYPE html>
<html>
  <head>
    <title>Billing</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <style>
        .required_field {
            color: #333;
        }
        .required_field::after {
            color: red;
            content: '*';
            font-size: 16px;
            font-weight: bolder;
            padding: 0 5px;
        }
    </style>
  </head>

  <body id="page-top">
    <!-- Main Content -->
    <div id="container">
        <div class="row justify-content-center">
            <!-- Begin Page Content -->
            <div class="col-xl-10 col-lg-12 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="row">
                            <div class="col-lg-6 d-none d-lg-block"></div>
                            <div class="col-lg-6">
                                <div class="p-5">
                                    <%= yield %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <!-- /.container-fluid -->
        </div>
    </div>
    <!-- End of Main Content -->

    <!-- Footer -->
    <footer class="sticky-footer bg-white">
        <div class="container my-auto">
            <div class="copyright text-center my-auto">
                <% if Date.today.year == 2024 %>
                    <span>Copyright &copy; <%= Date.today.year %> | Billing Management System By <a href="http://dapsoft.co.zw" target="_blank">Dapsoft Solutions</a></span>
                <% else %>
                    <span>Copyright &copy; 2024 - <%= Date.today.year %> | Billing Management System By <a href="http://dapsoft.co.zw" target="_blank">Dapsoft Solutions</a></span>
                <% end %>
            </div>
        </div>
    </footer>
    <!-- End of Footer -->

  </body>
</html>
